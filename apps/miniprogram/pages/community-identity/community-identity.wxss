.identity-page { padding-top: 32rpx; }
.identity-profile { display: flex; min-height: 112rpx; align-items: center; }
.identity-avatar { display: block; width: 92rpx; height: 92rpx; border-radius: 50%; }
.identity-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #fff; background: #303633; font-size: 32rpx; font-weight: 900; }
.identity-profile-main { min-width: 0; margin-left: 18rpx; flex: 1; }
.identity-name { overflow: hidden; color: #242824; font-size: 31rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.identity-level { margin-top: 7rpx; color: #347453; font-size: 20rpx; font-weight: 750; }
.sync-state { color: #929994; font-size: 18rpx; }
.progress-section { margin-top: 24rpx; padding: 24rpx; background: #303633; border-radius: 8rpx; }
.progress-head { display: flex; align-items: center; justify-content: space-between; color: #fff; font-size: 23rpx; font-weight: 800; }
.progress-head text { color: rgba(255,255,255,.68); font-size: 19rpx; }
.progress-track { height: 10rpx; margin-top: 22rpx; overflow: hidden; background: rgba(255,255,255,.16); border-radius: 5rpx; }
.progress-value { height: 100%; max-width: 100%; background: #8cc5a5; border-radius: 5rpx; }
.progress-note { margin-top: 13rpx; color: rgba(255,255,255,.63); font-size: 18rpx; }
.identity-metrics { display: grid; min-height: 126rpx; margin-top: 20rpx; padding: 14rpx 0; background: #fff; border: 1rpx solid #e4e8e4; border-radius: 8rpx; grid-template-columns: repeat(3,1fr); box-sizing: border-box; }
.identity-metrics > view { display: flex; align-items: center; justify-content: center; flex-direction: column; border-right: 1rpx solid #e8ebe8; }
.identity-metrics > view:last-child { border-right: 0; }
.identity-metrics text,.identity-metrics label { display: block; }
.identity-metrics text { color: #29302b; font-size: 33rpx; font-weight: 900; }
.identity-metrics label { margin-top: 5rpx; color: #858d87; font-size: 18rpx; }
.section-head { display: flex; min-height: 88rpx; padding: 22rpx 2rpx 12rpx; align-items: flex-end; justify-content: space-between; box-sizing: border-box; }
.section-head text { color: #282e2a; font-size: 29rpx; font-weight: 900; }
.section-head label { color: #909691; font-size: 18rpx; }
.level-list { overflow: hidden; background: #fff; border: 1rpx solid #e4e8e4; border-radius: 8rpx; }
.level-row { display: grid; min-height: 104rpx; padding: 18rpx 21rpx; align-items: center; border-bottom: 1rpx solid #e9ece9; grid-template-columns: 42rpx minmax(0,1fr) auto; gap: 14rpx; box-sizing: border-box; }
.level-row:last-child { border-bottom: 0; }
.level-current { background: #f2f7f3; }
.level-state { width: 30rpx; height: 30rpx; border: 2rpx solid #c7cec9; border-radius: 50%; box-sizing: border-box; }
.level-state-achieved { display: flex; align-items: center; justify-content: center; color: #fff; background: #438061; border-color: #438061; font-size: 18rpx; font-weight: 900; }
.level-main { min-width: 0; }
.level-main text,.level-main label { display: block; }
.level-main text { color: #303631; font-size: 23rpx; font-weight: 820; }
.level-main label { margin-top: 6rpx; color: #858d87; font-size: 18rpx; }
.current-label { padding: 5rpx 9rpx; color: #347352; background: #deeee4; border-radius: 4rpx; font-size: 17rpx; }
.identity-actions { display: grid; margin-top: 26rpx; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.identity-actions button { width: 100%; height: 76rpx; margin: 0; padding: 0 10rpx; border-radius: 7rpx; font-size: 21rpx; font-weight: 750; line-height: 76rpx; }
.primary-action { color: #fff; background: #343a36; }
.secondary-action { color: #3e4741; background: #e8ebe8; }
