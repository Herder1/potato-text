.page {
  min-height: 100vh;
  background: #f4f6f4;
  box-sizing: border-box;
}

/* 自定义导航栏：结构与 card-set-editor / note-editor 一致（fixed + 等高占位让位，右侧动作避让微信胶囊）。
   注意别再改成 sticky：sticky 已经占住文档流，再叠加等高占位就会在页面顶部空出一整条（2026-09-22 真机反馈）。 */
.editor-nav {
  position: fixed;
  z-index: 10;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  padding-left: 16rpx;
  align-items: center;
  background: #f4f6f4;
  border-bottom: 1rpx solid #e5eae6;
  box-sizing: border-box;
}

.nav-back {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
}

.nav-back image {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  display: flex;
  width: 220rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #222a25;
  font-size: 30rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translateX(-50%);
}

/* 导航栏右侧不放动作按钮：保存统一在页面底部的整宽按钮（产品负责人 2026-09-22 的效果图）。 */

.edit-body {
  padding: 8rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.avatar-block {
  display: flex;
  padding: 20rpx 0 8rpx;
  flex-direction: column;
  align-items: center;
}

.avatar-large {
  display: block;
  width: 152rpx;
  height: 152rpx;
  border-radius: 44rpx;
}

.avatar-large-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0b9588;
  background: #e3f6f1;
  font-size: 60rpx;
  font-weight: 800;
}

/* 「更换头像」：白底胶囊 + 品牌青绿相机图标与文字（2026-09-22 效果图 + 真机反馈"字改绿色、要居中"→"太长了，文字细一点"）。
   视觉全在这个 view 上；采集入口是覆盖它的透明 .avatar-change-button（open-type 只能由 button 承载），
   这样胶囊宽度只由 padding 决定，不会被 button 自带的内边距撑宽。 */
.avatar-change {
  position: relative;
  display: flex;
  height: 60rpx;
  margin: 20rpx 0 0;
  padding: 0 22rpx;
  align-self: center;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #0b9588;
  background: #ffffff;
  border: 1rpx solid #e6eae7;
  border-radius: 30rpx;
  font-size: 24rpx;
  line-height: 1;
}
.avatar-change-label {
  color: #0b9588;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

/* 采集入口：透明覆盖整个胶囊，点哪儿都算点它；按下给一层淡绿反馈。 */
.avatar-change-button {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 30rpx;
}
.avatar-change-button:active { background: rgba(11, 149, 136, .08); }
.avatar-change-button::after { border: 0; }

.avatar-change-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.group-title {
  margin: 42rpx 6rpx 16rpx;
  color: #6c7771;
  font-size: 24rpx;
}

.group-card {
  overflow: hidden;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(40,55,46,.05);
}

.group-row {
  display: flex;
  min-height: 108rpx;
  padding: 0 28rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eff1ee;
}
/* 行被 picker 包着，:last-child 会落在 picker 上：两种形态都要去掉最后一行的分隔线。 */
.group-card > view:last-child,
.group-card > picker:last-child > .group-row { border-bottom: 0; }
/* picker 是内建组件，显式声明为块级，保证被包住的行与普通行同宽。 */
.group-card > picker { display: block; }

.row-label {
  color: #22261f;
  font-size: 29rpx;
}

/* 昵称 / 个人签名也是「右对齐值 + 箭头」的行样式：不要输入框的深色底，与其他行一致。 */
.row-input {
  min-width: 0;
  height: 68rpx;
  padding: 0;
  flex: 1;
  color: #22261f;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  text-align: right;
  box-sizing: border-box;
}

.row-value {
  max-width: 380rpx;
  overflow: hidden;
  color: #8a918c;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-user-id {
  max-width: 100%;
  white-space: normal;
  word-break: break-all;
  text-align: right;
  line-height: 1.3;
}
.row-copy {
  margin-left: 12rpx;
  flex: 0 0 auto;
  color: #0b9588;
  font-size: 24rpx;
}

.row-value-wrap {
  display: flex;
  min-width: 0;
  margin-left: 24rpx;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
}

.row-arrow {
  margin-left: 8rpx;
  color: #b3b8b4;
  font-size: 28rpx;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.row-sub {
  margin-top: 6rpx;
  color: #8a918c;
  font-size: 21rpx;
  line-height: 1.4;
}

.group-row-switch {
  min-height: 124rpx;
}

/* 底部整宽保存按钮（2026-09-22：导航栏不再放「保存」；改为跟在表单后的整宽主按钮，不再固定屏幕底部）。
   用 view + role=button，避免小程序 button 标签自带的内边距/居中样式干扰整宽与居中。 */
.save-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  margin-top: 40rpx;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #0b9588;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}
.save-button:active { opacity: .86; }
.save-button-busy { opacity: .6; }
