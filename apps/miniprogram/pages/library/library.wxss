.drawer-title {
  font-size: 34rpx;
  font-weight: 900;
}

.drawer-head button {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  color: #555555;
  background: #eeeeec;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 68rpx;
}

.drawer-scroll {
  min-height: 0;
  padding: 0 26rpx 60rpx;
  flex: 1;
  box-sizing: border-box;
}

.drawer-section-label {
  padding: 30rpx 4rpx 14rpx;
  color: #999999;
  font-size: 21rpx;
}

.project-option {
  min-height: 132rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.project-option-active {
  background: #f2f2f0;
}

.project-option-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.project-option-name {
  color: #171717;
  font-size: 27rpx;
  font-weight: 800;
}

.project-option-detail {
  margin-top: 7rpx;
  color: #858585;
  font-size: 20rpx;
}

.current-mark,
.pending-mark {
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
}

.current-mark {
  color: #2d7b4b;
  background: #e0f5e6;
}

.pending-mark {
  color: #777777;
  background: #eeeeec;
}

.subject-directory {
  margin: 12rpx 0 4rpx 68rpx;
  padding-left: 22rpx;
  border-left: 2rpx solid #e5e5e2;
}

.subject-directory-flat {
  margin-top: 0;
  margin-left: 24rpx;
}

.subject-directory-row {
  min-height: 72rpx;
  color: #555555;
  font-size: 23rpx;
}

.subject-directory-row text {
  width: 9rpx;
  height: 9rpx;
  margin-right: 16rpx;
  background: #b9b9b9;
  border-radius: 50%;
}

.upcoming-label {
  margin-top: 8rpx;
}

.project-option-disabled {
  opacity: 0.72;
}

.project-option-placeholder {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  color: #666666;
  background: #eeeeec;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.private-drawer-summary {
  display: flex;
  min-height: 116rpx;
  padding: 18rpx 20rpx;
  align-items: center;
  background: #f0f1ef;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.private-drawer-mark {
  display: flex;
  width: 58rpx;
  height: 68rpx;
  margin-right: 18rpx;
  align-items: center;
  justify-content: center;
  color: #176d87;
  background: #dff3f7;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.private-drawer-summary > view:nth-child(2) { min-width: 0; flex: 1; }
.private-drawer-summary text { display: block; font-size: 26rpx; font-weight: 850; }
.private-drawer-summary label { display: block; margin-top: 5rpx; color: #7b827e; font-size: 19rpx; }
.private-folder-label { display: flex; align-items: center; justify-content: space-between; }
.private-folder-label text:last-child { padding: 8rpx 4rpx; color: #176d87; font-size: 19rpx; }
.private-all-subdirectory { margin: 0 0 6rpx 34rpx; padding: 8rpx 0 4rpx 18rpx; border-left: 2rpx solid #e3e7e4; }
.private-unclassified-row { min-height: 66rpx; padding-left: 12rpx; color: #69716c; font-size: 21rpx; }
.private-folder-directory { padding: 2rpx 0 8rpx; }
.private-folder-row { display: grid; min-height: 76rpx; padding: 0 18rpx; grid-template-columns: 36rpx minmax(0,1fr) auto; align-items: center; color: #555b57; border-radius: 7rpx; font-size: 23rpx; box-sizing: border-box; }
.private-folder-row:active,.private-folder-row-active { color: #176d87; background: #edf7f9; }
.private-folder-row label { color: #929894; font-size: 19rpx; text-align: right; }
.private-folder-icon { position: relative; width: 24rpx; height: 17rpx; border: 2rpx solid currentColor; border-radius: 3rpx; box-sizing: border-box; }
.private-folder-icon::before { position: absolute; top: -7rpx; left: -2rpx; width: 11rpx; height: 6rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 3rpx 3rpx 0 0; box-sizing: border-box; content: ""; }
.private-folder-tools { display: flex; min-width: 100rpx; align-items: center; justify-content: flex-end; gap: 10rpx; }
.private-project-tools { display: flex; min-width: 102rpx; align-items: center; justify-content: flex-end; gap: 10rpx; }
.private-subcategory-add { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; color: #176d87; background: #e2f3f6; border-radius: 50%; font-size: 24rpx; line-height: 1; }
.folder-chevron { position: relative; display: block; width: 48rpx; height: 48rpx; flex: 0 0 48rpx; border-radius: 50%; box-sizing: border-box; }
.folder-chevron::after { position: absolute; top: 16rpx; left: 17rpx; width: 11rpx; height: 11rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); transition: transform 150ms ease; box-sizing: border-box; content: ""; }
.folder-chevron:active { background: #e2f3f6; }
.folder-chevron-open::after { top: 20rpx; transform: rotate(225deg); }
.private-subfolder-list { margin-left: 18rpx; padding-left: 18rpx; border-left: 2rpx solid #e5e8e6; }
.private-category-project { margin-top: 10rpx; background: #f2f2f0; }
.private-category-project + .private-category-project { margin-top: 8rpx; }
.private-category-managing { outline: 2rpx solid #27addf; outline-offset: 3rpx; }
.private-subject-list { margin-bottom: 8rpx; }
.private-subject-row { min-height: 72rpx; }
.private-book-list { margin-left: 18rpx; padding-left: 18rpx; border-left: 2rpx solid #e6e9e7; }
.private-book-row { min-height: 64rpx; padding-left: 8rpx; color: #737a75; font-size: 20rpx; }
.private-subfolder-row { min-height: 68rpx; padding-left: 12rpx; color: #6d746f; font-size: 21rpx; }
.private-folder-branch,.catalog-branch { position: relative; width: 24rpx; height: 2rpx; background: #c8ccc9; }
.private-folder-branch::before,.catalog-branch::before { position: absolute; bottom: 0; left: 0; width: 2rpx; height: 18rpx; background: #c8ccc9; content: ""; }

.catalog-directory { margin: 2rpx 0 8rpx 18rpx; padding-left: 16rpx; border-left: 2rpx solid #e5e5e2; }
.catalog-subject-row { display: grid; min-height: 72rpx; padding: 0 6rpx 0 16rpx; grid-template-columns: 36rpx minmax(0,1fr) 48rpx; align-items: center; color: #555b57; border-radius: 7rpx; font-size: 22rpx; box-sizing: border-box; }
.catalog-folder-icon { position: relative; width: 23rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 3rpx; box-sizing: border-box; }
.catalog-folder-icon::before { position: absolute; top: -7rpx; left: -2rpx; width: 10rpx; height: 6rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 3rpx 3rpx 0 0; box-sizing: border-box; content: ""; }
.catalog-book-list { margin-left: 18rpx; padding-left: 18rpx; border-left: 2rpx solid #e6e9e7; }
.catalog-book-row { display: grid; min-height: 64rpx; padding: 8rpx 14rpx 8rpx 4rpx; grid-template-columns: 34rpx minmax(0,1fr); align-items: center; color: #737a75; border-radius: 7rpx; font-size: 20rpx; line-height: 1.45; box-sizing: border-box; }
.catalog-row-active { color: #176d87; background: #edf7f9; }

.exam-category-directory {
  margin: 2rpx 0 8rpx 18rpx;
  padding-left: 16rpx;
  border-left: 2rpx solid #e5e5e2;
}

.exam-category-row {
  display: grid;
  min-height: 72rpx;
  padding: 0 14rpx 0 16rpx;
  grid-template-columns: 36rpx minmax(0, 1fr) auto;
  align-items: center;
  color: #555b57;
  border-radius: 7rpx;
  font-size: 22rpx;
  box-sizing: border-box;
}

.exam-category-row label {
  color: #959a96;
  font-size: 19rpx;
}

.exam-category-row-active {
  color: #176d87;
  background: #edf7f9;
}

.exam-category-row-active label { color: #43879a; }

.exam-category-icon {
  position: relative;
  width: 22rpx;
  height: 26rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.exam-category-icon::before,
.exam-category-icon::after {
  position: absolute;
  left: 4rpx;
  width: 10rpx;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.exam-category-icon::before { top: 7rpx; }
.exam-category-icon::after { top: 14rpx; }
