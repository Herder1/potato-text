.library-fab { position: fixed; z-index: 1200; right: 30rpx; bottom: calc(142rpx + env(safe-area-inset-bottom)); display: flex; height: 88rpx; min-width: 88rpx; padding: 0 28rpx; align-items: center; justify-content: center; color: #fff; background: #303330; border-radius: 44rpx; gap: 12rpx; box-sizing: border-box; }
