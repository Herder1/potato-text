.note-compose-page { min-height: 100vh; color: #202421; background: #fbfbfa; }
.editor-nav { position: fixed; z-index: 120; top: 0; right: 0; left: 0; display: flex; padding-left: 16rpx; align-items: flex-end; background: rgba(251,251,250,.98); border-bottom: 1rpx solid #eceeeb; box-sizing: border-box; }
.editor-nav-back,.editor-nav-more { display: flex; width: 68rpx; height: 82rpx; flex: 0 0 68rpx; align-items: center; justify-content: center; }
.editor-nav-back image { width: 36rpx; height: 36rpx; }
.editor-nav-title { display: flex; height: 82rpx; align-items: center; font-size: 27rpx; font-weight: 800; white-space: nowrap; }
.editor-nav-spacer { min-width: 8rpx; flex: 1; }
.editor-nav-done { display: flex; min-width: 72rpx; height: 82rpx; padding: 0 8rpx; align-items: center; justify-content: center; color: #17728c; font-size: 23rpx; font-weight: 800; box-sizing: border-box; }
.editor-nav-more { color: #4e5551; font-size: 25rpx; font-weight: 900; letter-spacing: 0; }
.compose-main { min-height: calc(100vh - 88rpx); }
.compose-title { width: 100%; height: 116rpx; padding: 18rpx 34rpx 0; color: #202421; background: #fbfbfa; border-bottom: 1rpx solid #eceeeb; font-size: 42rpx; font-weight: 900; box-sizing: border-box; }
.editor-toolbar { position: sticky; z-index: 50; top: 0; width: 100%; height: 84rpx; background: rgba(247,248,246,.98); border-bottom: 1rpx solid #e2e5e1; white-space: nowrap; }
.toolbar-track { display: inline-flex; height: 84rpx; padding: 0 18rpx; align-items: center; gap: 7rpx; box-sizing: border-box; }
.tool-button { display: flex; width: 58rpx; height: 58rpx; flex: 0 0 58rpx; align-items: center; justify-content: center; color: #4f5752; background: transparent; border-radius: 6rpx; font-size: 22rpx; line-height: 1; box-sizing: border-box; }
.tool-button:active,.tool-active { background: #e3e8e4; color: #1f2521; }
.tool-wide { width: 82rpx; flex-basis: 82rpx; font-size: 19rpx; }
.check-symbol { display: flex; width: 30rpx; height: 30rpx; align-items: center; justify-content: center; border: 2rpx solid #5f6862; border-radius: 4rpx; font-size: 18rpx; }
.format-bold { font-weight: 900; }.format-italic { font-family: serif; font-style: italic; }.format-underline { text-decoration: underline; }.format-strike { text-decoration: line-through; }
.color-tool { position: relative; flex-direction: column; }
.color-tool text { line-height: 30rpx; }.color-line { width: 28rpx; height: 4rpx; background: #2184a3; }.background-mark { width: 30rpx; height: 10rpx; margin-top: -9rpx; background: #f2d25d; opacity: .72; }
.size-symbol { font-family: serif; font-size: 19rpx; }.align-symbol { display: flex; width: 29rpx; flex-direction: column; gap: 5rpx; }.align-symbol view { width: 29rpx; height: 3rpx; background: #5a625d; }.align-symbol view:nth-child(2) { width: 21rpx; }.box-symbol { display: flex; width: 30rpx; height: 27rpx; align-items: center; justify-content: center; border: 2rpx solid #69716c; font-size: 16rpx; }
.toolbar-popover { position: relative; z-index: 60; padding: 12rpx 18rpx; background: #f5f7f4; border-bottom: 1rpx solid #e2e5e1; box-sizing: border-box; }
.style-options { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; }.style-options view { display: flex; height: 60rpx; align-items: center; justify-content: center; color: #4d5650; background: #fff; border: 1rpx solid #e1e5e1; border-radius: 6rpx; font-size: 19rpx; }
.palette-options { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 9rpx; }.palette-options > view { display: flex; min-width: 0; height: 62rpx; flex-direction: column; align-items: center; justify-content: center; color: #747c77; font-size: 15rpx; }.palette-options .palette-swatch { width: 31rpx; height: 31rpx; border: 1rpx solid #d9deda; border-radius: 50%; }.palette-options text { margin-top: 3rpx; }
.size-options,.align-options,.insert-options { display: flex; align-items: center; justify-content: space-around; }.size-options view { display: flex; min-width: 88rpx; height: 62rpx; align-items: center; justify-content: center; gap: 8rpx; }.size-options label { color: #7d847f; font-size: 16rpx; }.align-options view { display: flex; height: 58rpx; padding: 0 24rpx; align-items: center; justify-content: center; color: #4d5550; background: #fff; border-radius: 6rpx; font-size: 19rpx; }.insert-options view { display: flex; min-width: 100rpx; height: 64rpx; align-items: center; justify-content: center; gap: 8rpx; }.insert-options text { display: flex; width: 35rpx; height: 35rpx; align-items: center; justify-content: center; color: #fff; background: #4e5651; border-radius: 50%; font-size: 16rpx; }.insert-options label { color: #4d5550; font-size: 19rpx; }
.compose-editor { min-height: calc(100vh - 320rpx); padding: 28rpx 34rpx 160rpx; color: #343a36; background: #fff; font-size: 27rpx; line-height: 1.8; box-sizing: border-box; }
.reference-strip { display: flex; min-height: 68rpx; padding: 0 34rpx 24rpx; align-items: center; color: #78817b; background: #fff; font-size: 18rpx; gap: 18rpx; }
.more-mask { position: fixed; z-index: 125; inset: 0; background: rgba(27,30,28,.12); }.more-menu { position: fixed; z-index: 130; top: 150rpx; right: 112rpx; visibility: hidden; width: 260rpx; padding: 7rpx 0; opacity: 0; background: #fff; border: 1rpx solid #dfe3df; border-radius: 8rpx; transform: translateY(-8rpx); }.more-menu-open { visibility: visible; opacity: 1; transform: translateY(0); }.more-menu view { height: 72rpx; padding: 0 22rpx; color: #3f4742; border-bottom: 1rpx solid #eceeec; font-size: 21rpx; line-height: 72rpx; }.more-menu view:last-child { border-bottom: 0; }.more-menu .danger { color: #a14a43; }
.question-picker-layer { position: fixed; z-index: 200; inset: 0; }.question-picker-mask { position: absolute; inset: 0; background: rgba(25,29,26,.34); }.question-picker-sheet { position: absolute; right: 0; bottom: 0; left: 0; height: 68vh; padding-bottom: env(safe-area-inset-bottom); background: #fbfbfa; border-radius: 16rpx 16rpx 0 0; box-sizing: border-box; }.question-picker-head { display: flex; height: 104rpx; padding: 0 28rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e4e7e4; box-sizing: border-box; }.question-picker-head text,.question-picker-head label { display: block; }.question-picker-head text { font-size: 27rpx; font-weight: 850; }.question-picker-head label { margin-top: 5rpx; color: #858d87; font-size: 18rpx; }.question-picker-head > view:last-child { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; color: #6b736e; font-size: 38rpx; }
.question-picker-list { height: calc(68vh - 104rpx - env(safe-area-inset-bottom)); }.question-picker-row { display: grid; min-height: 112rpx; margin: 0 28rpx; padding: 16rpx 0; grid-template-columns: 50rpx minmax(0,1fr) 46rpx; align-items: center; gap: 14rpx; border-bottom: 1rpx solid #e7eae7; box-sizing: border-box; }.question-picker-mark,.question-picker-add { display: flex; align-items: center; justify-content: center; border-radius: 50%; }.question-picker-mark { width: 48rpx; height: 48rpx; color: #2a7189; background: #e1f1f5; font-size: 18rpx; font-weight: 850; }.question-picker-add { width: 42rpx; height: 42rpx; color: #fff; background: #343834; font-size: 25rpx; }.question-picker-row text,.question-picker-row label { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.question-picker-row text { font-size: 22rpx; font-weight: 750; }.question-picker-row label { margin-top: 5rpx; color: #878f89; font-size: 17rpx; }.question-picker-empty { padding: 90rpx 28rpx; color: #858d87; font-size: 21rpx; text-align: center; }
.preview-layer { position: fixed; z-index: 300; inset: 0; background: #fbfbfa; }.preview-head { display: grid; height: 96rpx; padding: env(safe-area-inset-top) 28rpx 0; grid-template-columns: 90rpx 1fr 90rpx; align-items: center; border-bottom: 1rpx solid #e5e8e5; box-sizing: content-box; }.preview-head view { color: #28748c; font-size: 21rpx; }.preview-head view:last-child { text-align: right; }.preview-head text { font-size: 25rpx; font-weight: 800; text-align: center; }.preview-scroll { height: calc(100vh - 96rpx - env(safe-area-inset-top)); padding: 38rpx 34rpx 80rpx; box-sizing: border-box; }.preview-title { font-size: 42rpx; font-weight: 900; line-height: 1.4; }.preview-content { display: block; margin-top: 28rpx; color: #3d4540; font-size: 26rpx; line-height: 1.8; }
.preview-head .preview-back { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; }
.preview-back image { width: 36rpx; height: 36rpx; }
