<view class="page-shell settings-page">
  <!-- 2026-10-17（第二次修按钮重叠）：这两个动作原本用原生 <button>，在三星等机型上
       button 的内置盒模型（padding/margin/宽度/line-height）不受作者样式完全控制，
       出现过「文字出框」和「按钮整体超出屏幕、压住下一行状态文字」两种形态。
       改用 view + role/aria 自绘按钮，尺寸完全由本页 wxss 决定；禁用态用 class 表达，
       loading 用文案「同步中…」表达（不再依赖 button 的 loading 属性）。 -->
  <view class="sync-actions">
    <view
      class="sync-button {{cloudBusy || !loggedIn ? 'sync-button-off' : ''}}"
      bindtap="retryPersonalAssets"
      role="button"
      aria-label="重试同步"
      aria-disabled="{{cloudBusy || !loggedIn}}"
    >
      <text class="sync-icon">⟳</text><text class="sync-label">{{cloudBusy ? '同步中…' : '重试同步'}}</text>
    </view>
    <view
      class="sync-button {{cloudBusy || !loggedIn ? 'sync-button-off' : ''}}"
      bindtap="exportPersonalAssets"
      role="button"
      aria-label="导出我的数据"
      aria-disabled="{{cloudBusy || !loggedIn}}"
    >
      <text class="sync-icon">⤓</text><text class="sync-label">导出我的数据</text>
    </view>
  </view>
  <view class="sync-status">{{personalSyncLabel}}</view>
  <view class="cloud-warning" wx:if="{{blockedCount}}">{{blockedCount}} 条内容含本机附件或超过同步大小限制，尚未上传。附件云存储未接通，请勿清除本机缓存。</view>
  <view class="cloud-warning" wx:if="{{draftCount}}">{{draftCount}} 篇笔记草稿仅保留在本机，完成保存后才会同步。</view>
  <view class="cloud-warning" wx:if="{{unownedCount}}">本机有 {{unownedCount}} 项尚未归属账号的旧内容，暂不自动上传。原内容仍保留在未登录工作区。</view>

  <view class="cloud-conflict" wx:for="{{cloudConflicts}}" wx:key="id">
    <view class="conflict-title">{{item.title}}</view>
    <view class="conflict-label">云端当前版本</view>
    <scroll-view class="cloud-version" scroll-y="true"><text selectable="true">{{item.currentText}}</text></scroll-view>
    <view class="conflict-label">待确认版本</view>
    <scroll-view class="cloud-version" scroll-y="true"><text selectable="true">{{item.incomingText}}</text></scroll-view>
    <view class="conflict-actions">
      <button class="secondary-button" data-id="{{item.id}}" data-choice="current" bindtap="resolvePersonalConflict" disabled="{{cloudBusy}}">保留云端版本</button>
      <button class="secondary-button" data-id="{{item.id}}" data-choice="incoming" bindtap="resolvePersonalConflict" disabled="{{cloudBusy}}">采用待确认版本</button>
    </view>
  </view>

  <view class="settings-list panel">
    <view
      class="settings-row {{item.danger ? 'settings-row-danger' : ''}}"
      wx:for="{{rows}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="openRow"
      hover-class="settings-row-press"
      role="button"
      aria-label="{{item.title}}"
    >
      <view class="settings-copy">
        <text class="settings-title">{{item.title}}</text>
        <text class="settings-note">{{item.note}}</text>
      </view>
      <text class="settings-arrow">›</text>
    </view>
  </view>

  <button class="logout-button" bindtap="logoutAccount" disabled="{{!loggedIn}}">{{loggedIn ? '退出登录' : '登录后可退出'}}</button>

  <view class="version-line">当前版本 {{version}}</view>
</view>
