/* ── 视觉改版：留白 / 暖灰底 / 卡片去投影 / 翻面 / 底部导航 ── */
.page{min-height:100vh;padding:0 32rpx calc(220rpx + env(safe-area-inset-bottom));background:#fdfcfa;box-sizing:border-box}
.card-box-nav{background:rgba(253,252,250,.96);border-bottom-color:#efe9e1}
.page-decor{position:fixed;z-index:0;top:0;right:0;bottom:0;left:0;overflow:hidden;pointer-events:none}
.page-arc{position:absolute;border-radius:50%}
.page-arc-a{top:-300rpx;right:-240rpx;width:720rpx;height:720rpx;background:rgba(255,255,255,.78)}
.page-arc-b{bottom:-420rpx;left:-320rpx;width:860rpx;height:860rpx;border:2rpx solid rgba(214,203,186,.4);background:rgba(255,255,255,.5)}
.search-row{position:relative;z-index:2;margin-top:60rpx}
.search{height:84rpx;background:#fff;border:1rpx solid #ece6de;border-radius:16rpx;box-shadow:none}
.grid{position:relative;z-index:2;margin-top:36rpx;gap:24rpx}
.set{display:flex;min-height:260rpx;padding:24rpx;flex-direction:column;background:#fff;border:1rpx solid #ece6de;border-radius:28rpx;box-shadow:none;box-sizing:border-box}
.set-selected{background:#f2fbf8;border:3rpx solid #2f9fff;box-shadow:none}
.set::before{display:none}
/* 上色的卡片不加暖灰描边，避免浅色块镶灰边显脏；次要文字也换中性灰。 */
/* 上色卡片的描边由行内同色玻璃边提供，这里不再强制透明。 */
.set-tinted{border-color:var(--card-edge)}
.set-tinted .set-count,.set-tinted .set-title{color:#22201c}
.set-tinted .set-count{color:#8d938f}
.set-tinted .set-back-label,.set-tinted .set-back-author{color:#8d938f}
.set-tinted .set-back-text{color:#3f4744}
.set-face{display:flex;flex:1;flex-direction:column;animation:set-face-in .22s ease-out}

.set-flip{display:flex;width:44rpx;height:44rpx;flex:0 0 44rpx;align-items:center;justify-content:center;background:#f1f6f4;border-radius:50%}
.set-in-selection .set-flip{display:none}
.set-flip:active{background:#e3efeb}
.set-flip image{display:block;width:25rpx;height:25rpx}
.set-flip-back image{transform:rotate(180deg)}
.set-head{display:flex;min-height:44rpx;align-items:center;justify-content:space-between}
.set-count{margin-top:0;color:#a79d8e;font-size:17rpx}
.set-title{display:-webkit-box;margin-top:12rpx;padding:0;overflow:hidden;color:#22201c;font-size:30rpx;font-weight:800;line-height:1.32;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.set-foot{display:flex;margin-top:auto;padding-top:24rpx;align-items:center;justify-content:space-between;color:#8b8478;font-size:17rpx}
.set-amber .set-foot text:last-child{color:#ad7c22}
.set-blue .set-foot text:last-child{color:#3b7b9c}
.set-rose .set-foot text:last-child{color:#a66870}
.set-back-label{color:#a79d8e;font-size:17rpx}
.set-back-text{display:-webkit-box;min-height:32rpx;margin-top:12rpx;overflow:hidden;color:#4d4a44;font-size:21rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:3}
.set-back-author{margin-top:auto;padding-top:18rpx;color:#8b8478;font-size:17rpx}
.progress{margin-top:12rpx;background:#efe9e1}
@keyframes set-face-in{from{opacity:0;transform:rotateY(-18deg)}to{opacity:1;transform:rotateY(0)}}
/* 底栏几何与题包页一致：左「智能练习」/ 中「新建卡集」主操作胶囊 / 右「更多」；分享已收进「更多」抽屉。 */
.float-bar{position:fixed;z-index:6;right:48rpx;bottom:calc(40rpx + env(safe-area-inset-bottom));left:48rpx;display:flex;height:106rpx;padding:0 8rpx;align-items:center;justify-content:space-around;background:rgba(255,255,255,.98);border:0;border-radius:56rpx;box-shadow:0 10rpx 30rpx rgba(35,55,44,.14);box-sizing:border-box}
.float-bar .float-action{display:flex;min-width:92rpx;height:86rpx;flex:1;flex-direction:column;align-items:center;justify-content:center;color:#65726b;border-radius:44rpx}
.float-bar .float-action:active{background:#f0f4f1}
.float-bar .float-smart{display:flex;width:30rpx;height:30rpx;margin-top:0;align-items:center;justify-content:center;color:#59665f;font-size:26rpx;line-height:1}
.float-bar .float-more{display:flex;height:30rpx;margin-top:0;align-items:center;justify-content:center;color:#65726b;font-size:29rpx;letter-spacing:3rpx;line-height:24rpx}
.float-bar .float-primary{display:flex;width:116rpx;height:86rpx;flex:0 0 116rpx;flex-direction:column;align-items:center;justify-content:center;color:#fff;background:#19211d;border-radius:44rpx;font-size:16rpx;font-weight:800;gap:3rpx}
.float-bar .float-primary:active{opacity:.82}
.float-bar .float-plus{display:flex;width:28rpx;height:28rpx;margin:0;align-items:center;justify-content:center;color:#fff;font-size:31rpx;font-weight:500;line-height:1}
.float-bar label{margin-top:4rpx;font-size:17rpx;line-height:1.2}

/* ── DEC-067：底栏「更多」抽屉（与知识卡卡集页同一套视觉）── */
.drawer-layer{position:fixed;z-index:40;top:0;right:0;bottom:0;left:0}
.drawer-mask{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(24,35,29,.34)}
.more-drawer{position:absolute;right:0;bottom:0;left:0;max-height:78vh;overflow-y:auto;padding:28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));background:#fff;border-radius:28rpx 28rpx 0 0;animation:drawer-up .24s ease-out;box-sizing:border-box}
.drawer-head{display:flex;padding-bottom:24rpx;align-items:center;justify-content:space-between}
.drawer-head>text:first-child{min-width:0;overflow:hidden;color:#22201c;font-size:34rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}
.drawer-close{flex:0 0 auto;color:#93998f;font-size:26rpx}
.drawer-section{padding-top:26rpx}
.drawer-section-title{padding-bottom:20rpx;color:#a79d8e;font-size:22rpx}
.drawer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28rpx 18rpx}
.drawer-item{display:flex;flex-direction:column;align-items:center;gap:12rpx}
.drawer-item image{display:block;width:44rpx;height:44rpx}
.drawer-item label{color:#4d4a44;font-size:20rpx;line-height:1.2;text-align:center}
/* 「分享卡集」仍是原生分享按钮，但按钮不能直接当网格项——它自带的盒子会让内容偏离列。
   做法：条目本身用普通 `.drawer-item` 参与网格排布，再让一个透明的原生分享按钮铺满它。 */
.drawer-item-share-host{position:relative}
.drawer-share-trigger{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;padding:0;background:transparent;border:none;border-radius:0;opacity:0;box-sizing:border-box}
.drawer-share-trigger::after{display:none;border:none}

/* DEC-079：导入卡集（社区卡片集 → 我的卡集） */
.import-drawer{max-height:78vh}
.import-note{padding:4rpx 0 16rpx;color:#a79d8e;font-size:20rpx;line-height:1.5}
.import-scroll{max-height:56vh}
.import-row{display:flex;padding:22rpx 4rpx;align-items:center;border-bottom:1rpx solid #eef1ee;gap:16rpx}
.import-row:active{background:#f6f7f5}
.import-row-done{opacity:.78}
.import-mark{display:flex;width:56rpx;height:56rpx;flex:0 0 56rpx;align-items:center;justify-content:center;color:#2b7188;background:#e1f1f5;border-radius:10rpx;font-size:22rpx;font-weight:800}
.import-copy{min-width:0;flex:1}
.import-copy text{display:block;overflow:hidden;color:#303530;font-size:23rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}
.import-copy label{display:block;margin-top:5rpx;overflow:hidden;color:#8a918c;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}
.import-state{flex:0 0 auto;padding:8rpx 18rpx;color:#fff;background:#2d322f;border-radius:999rpx;font-size:19rpx;font-weight:700}
.import-row-done .import-state{color:#7d857f;background:#eceeec}
.import-empty{padding:70rpx 20rpx;color:#8a918c;font-size:21rpx;text-align:center}
@keyframes drawer-up{from{transform:translateY(100%)}to{transform:translateY(0)}}

/* ── DEC-068：卡盒颜色面板（统一颜色 / 彩虹色）── */
.color-panel{max-height:82vh}
.color-modes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;padding:6rpx 0 8rpx}
.color-mode{display:flex;height:132rpx;padding:0 24rpx;align-items:center;justify-content:center;color:#4d4a44;background:#f5f3ef;border:2rpx solid transparent;border-radius:20rpx;gap:14rpx;box-sizing:border-box}
.color-mode image{display:block;width:44rpx;height:44rpx}
.color-mode label{font-size:23rpx;font-weight:650}
.color-mode-active{color:#1c1a17;background:#fdf3e3;border-color:#e8cfa4}
.color-sheet-grid{display:grid;padding:22rpx 0 6rpx;grid-template-columns:repeat(4,minmax(0,1fr));gap:22rpx}
.color-swatch{height:132rpx;background:#f4f6f4;border:4rpx solid transparent;border-radius:20rpx;box-sizing:border-box}
.color-swatch-active{position:relative;border-color:#4a74a6}
.color-swatch-active::after{position:absolute;right:14rpx;bottom:12rpx;color:#4a74a6;font-size:26rpx;content:"✓"}
.color-note{padding:16rpx 0 4rpx;color:#a79d8e;font-size:20rpx;line-height:1.5}
.color-apply{display:flex;height:92rpx;margin-top:24rpx;align-items:center;justify-content:center;color:#fff;background:#2d322f;border-radius:20rpx;font-size:26rpx;font-weight:700}
.color-apply:active{background:#1f231f}
.set-selected.set-tinted,.set-tinted.set-selected{border:3rpx solid #2f9fff}
/* 玻璃/水晶质感：边缘受光 + 背光侧同色暗部（体现在厚度，而非塑料式白雾）。 */
.set{box-shadow:inset 0 2rpx 0 rgba(255,255,255,.9),inset 2rpx 0 0 rgba(255,255,255,.5),inset 0 -2rpx 0 rgba(255,255,255,.3),inset -10rpx -14rpx 26rpx -18rpx var(--card-edge,rgba(0,0,0,0))}
/* DEC-067：选中工具栏的调色板（与卡集页同一套视觉）。 */
.selection-toolbar{width:556rpx}
.color-picker{position:fixed;z-index:36;display:grid;padding:16rpx;grid-template-columns:repeat(5,64rpx);gap:16rpx;background:#2d322f;border-radius:18rpx;box-shadow:0 10rpx 30rpx rgba(24,35,29,.28)}
.color-picker-left{left:28rpx}
.color-picker-center{left:50%;transform:translateX(-50%)}
.color-picker-right{right:28rpx}
.color-dot{width:64rpx;height:64rpx;background:#f4f6f4;border:4rpx solid transparent;border-radius:50%;box-sizing:border-box}
.color-dot-none{background:#fff;box-shadow:inset 0 0 0 2rpx #d9e0dc}
.color-dot-active{border-color:#fff}
