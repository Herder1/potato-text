<view class="page-shell assets-page">
  <view class="assets-head"><view><view class="page-title">我的资产</view><view class="page-subtitle">统一管理创建、收藏和公开内容</view></view><view class="total-count"><text>{{stats.total}}</text>项资产</view></view>

  <view class="status-strip"><view><text>{{stats.questions}}</text><text>题目</text></view><view><text>{{stats.packs}}</text><text>题包</text></view><view><text>{{stats.notes}}</text><text>笔记</text></view><view><text>{{stats.collected}}</text><text>已复制</text></view><view><text>{{stats.pendingCount}}</text><text>待初筛</text></view></view>

  <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false"><view class="filter-row"><view wx:for="{{filters}}" wx:key="id" class="filter {{activeFilter === item.id ? 'filter-active' : ''}}" data-id="{{item.id}}" bindtap="selectFilter">{{item.label}}</view></view></scroll-view>

  <view class="asset-list" wx:if="{{visibleAssets.length}}">
    <view class="asset-card" wx:for="{{visibleAssets}}" wx:key="id" data-id="{{item.id}}" bindtap="openAsset" role="button" aria-label="{{item.title}}">
      <view class="asset-card-head"><view class="asset-title">{{item.title}}</view><text class="status status-{{item.moderationStatus}}">{{item.statusLabel}}</text></view>
      <view class="asset-desc" wx:if="{{item.summary}}">{{item.summary}}</view>
      <view class="asset-foot">
        <view class="asset-meta"><text wx:if="{{item.metaPrimary}}">{{item.metaPrimary}}</text><text>更新于 {{item.timeLabel}}</text></view>
        <view class="asset-more" data-id="{{item.id}}" catchtap="openAssetMenu" role="button" aria-label="更多操作"><view class="asset-more-dot"></view><view class="asset-more-dot"></view><view class="asset-more-dot"></view></view>
      </view>
    </view>
  </view>
  <view class="asset-empty" wx:else><view>还没有这类资产</view><text>可前往题包或笔记页面创建</text></view>

  <view class="asset-mask" wx:if="{{selectedAsset}}" bindtap="closeAsset"></view>
  <view class="asset-sheet" wx:if="{{selectedAsset}}">
    <view class="sheet-handle"></view>
    <view class="sheet-head"><view><text>{{selectedAsset.typeLabel}} · {{selectedAsset.statusLabel}}</text><view>{{selectedAsset.title}}</view></view><text bindtap="closeAsset">×</text></view>
    <scroll-view class="sheet-scroll" scroll-y="true">
      <view class="sheet-path">{{selectedAsset.catalogPath || '暂未归入目录'}}</view>
      <view class="sheet-summary">{{selectedAsset.summary}}</view>
      <view class="sheet-tags" wx:if="{{selectedAsset.tags.length}}"><text wx:for="{{selectedAsset.tags}}" wx:key="*this">#{{item}}</text></view>
      <view class="sheet-info" wx:if="{{selectedAsset.type === 'question_pack'}}"><view><text>题包来源</text><text>{{selectedAsset.sourceLabel}}</text></view><view><text>题目数量</text><text>{{selectedAsset.questionCount}} 道</text></view><view><text>资产归属</text><text>{{selectedAsset.ownership === 'collected' ? '复制资产' : '我的创作'}}</text></view></view>
      <view class="sheet-info" wx:else><view><text>原创类型</text><text>{{selectedAsset.originality === 'original' ? '原创' : (selectedAsset.originality === 'adapted' ? '改编整理' : '转载 / 复制')}}</text></view><view><text>公开范围</text><text>{{selectedAsset.visibility === 'public' ? '申请公开' : '仅自己可见'}}</text></view><view><text>资产归属</text><text>{{selectedAsset.ownership === 'collected' ? '复制资产' : '我的创作'}}</text></view><view wx:if="{{selectedAsset.type === 'question'}}"><text>所在题包</text><text>{{selectedAsset.membershipLabel}}</text></view></view>
      <view class="sheet-actions">
        <block wx:if="{{selectedAsset.type === 'question'}}">
          <view class="sheet-action edit-action" bindtap="editSelectedQuestion" role="button">编辑题目</view>
          <picker wx:if="{{packOptions.length}}" mode="selector" range="{{packOptions}}" range-key="name" bindchange="addSelectedQuestionToPack"><view class="sheet-action edit-action">加入题包</view></picker>
          <view wx:else class="sheet-action edit-action" bindtap="createPackForSelectedQuestion" role="button">新建题包并加入</view>
          <view class="sheet-action" data-id="{{selectedAsset.id}}" bindtap="toggleVisibility" role="button">{{selectedAsset.visibility === 'public' ? '设为私密' : '申请公开'}}</view>
          <view class="sheet-action delete-button" data-id="{{selectedAsset.id}}" bindtap="removeAsset" role="button">删除资产</view>
        </block>
        <block wx:elif="{{selectedAsset.type === 'question_pack'}}">
          <view class="sheet-action edit-action" bindtap="openSelectedPack" role="button">管理题包</view>
          <view class="sheet-action delete-button" data-id="{{selectedAsset.id}}" bindtap="removeAsset" role="button">删除题包</view>
        </block>
        <block wx:else>
          <view wx:if="{{selectedAsset.type === 'note'}}" class="sheet-action edit-action" bindtap="editSelectedNote" role="button">{{selectedAsset.moderationStatus === 'draft' ? '继续完善' : '编辑笔记'}}</view>
          <view wx:if="{{selectedAsset.moderationStatus !== 'draft'}}" class="sheet-action" data-id="{{selectedAsset.id}}" bindtap="toggleVisibility" role="button">{{selectedAsset.visibility === 'public' ? '设为私密' : '申请公开'}}</view>
          <view class="sheet-action delete-button" data-id="{{selectedAsset.id}}" bindtap="removeAsset" role="button">删除资产</view>
        </block>
      </view>
    </scroll-view>
  </view>
</view>
