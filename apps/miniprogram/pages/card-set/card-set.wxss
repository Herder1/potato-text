.card-flash{background-image:none}
.study-card.selected.study-card-tinted,.study-card-tinted.selected{border:3rpx solid #2f9fff}
/* 玻璃/水晶质感：边缘受光 + 背光侧同色暗部。 */
.study-card{box-shadow:inset 0 2rpx 0 rgba(255,255,255,.9),inset 2rpx 0 0 rgba(255,255,255,.5),inset 0 -2rpx 0 rgba(255,255,255,.3),inset -8rpx -12rpx 24rpx -16rpx var(--card-edge,rgba(0,0,0,0))}
