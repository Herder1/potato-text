.favorites-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f5f7f5;
  box-sizing: border-box;
}

.favorites-head { padding: 8rpx 4rpx 20rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1f2a24; }
.page-subtitle { margin-top: 8rpx; font-size: 24rpx; color: #7b8a83; line-height: 1.5; }

.favorites-section {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 42, 36, 0.05);
}

.favorites-section-head { display: flex; align-items: baseline; justify-content: space-between; }
.favorites-section-title { font-size: 30rpx; font-weight: 700; color: #1f2a24; }
.favorites-section-count { font-size: 24rpx; color: #8d9a94; }

.favorites-list { margin-top: 16rpx; }
.favorite-card,
.favorite-question {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1ef;
}
.favorite-card:last-child,
.favorite-question:last-child { border-bottom: none; }

.favorite-question { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.favorite-question-main { flex: 1; min-width: 0; }

.favorite-card-head { display: flex; align-items: center; gap: 12rpx; }
.favorite-type {
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: #137bff;
  background: rgba(19, 123, 255, 0.1);
  border-radius: 999rpx;
}
.favorite-status { font-size: 22rpx; color: #b7791f; }
.favorite-count { margin-left: auto; font-size: 22rpx; color: #8d9a94; }

.favorite-title { margin-top: 12rpx; font-size: 28rpx; color: #1f2a24; line-height: 1.45; }
.favorite-excerpt {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7a73;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.favorite-breadcrumb { margin-top: 8rpx; font-size: 22rpx; color: #8d9a94; }

.favorite-card-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.favorite-contributor { font-size: 24rpx; color: #7b8a83; }

.favorites-action {
  margin: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #137bff;
  background: rgba(19, 123, 255, 0.08);
  border: 1rpx solid rgba(19, 123, 255, 0.24);
  border-radius: 999rpx;
}
.favorites-action::after { border: none; }

.favorites-login,
.favorites-empty,
.favorites-tip {
  margin-top: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #7b8a83;
}
.favorites-login button,
.favorites-empty button { margin-top: 18rpx; display: inline-block; }
