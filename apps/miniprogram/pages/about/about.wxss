/* 「关于我们」页（2026-10-02 新建）：结构按产品负责人给的图3。 */
.about-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }

.about-hero { display: flex; padding: 46rpx 24rpx 40rpx; flex-direction: column; align-items: center; }
.about-mark {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  color: #0b9588;
  background: #e3f4ef;
  border-radius: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
}
.about-name { margin-top: 22rpx; color: #232824; font-size: 32rpx; font-weight: 700; }
.about-version { margin-top: 8rpx; color: #a3aaa6; font-size: 21rpx; }

.about-list { margin-top: 26rpx; overflow: hidden; }
.about-row { display: flex; padding: 28rpx 24rpx; align-items: center; border-bottom: 1rpx solid #f1f3f1; gap: 16rpx; }
.about-row:last-child { border-bottom: 0; }
.about-row-press { background: #f6f8f7; }
.about-icon { display: block; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; }
.about-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.about-title { min-width: 0; color: #232824; font-size: 27rpx; font-weight: 600; }
.about-desc { margin-top: 6rpx; color: #a3aaa6; font-size: 21rpx; line-height: 1.5; }
.about-arrow { flex: 0 0 auto; color: #b3bab6; font-size: 30rpx; line-height: 1; }

.about-footer { margin-top: 60rpx; color: #a3aaa6; font-size: 21rpx; line-height: 1.7; text-align: center; }
