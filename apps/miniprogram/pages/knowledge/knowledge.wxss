.knowledge-page {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #eef0ed;
  box-sizing: border-box;
}

.knowledge-nav {
  position: fixed;
  z-index: 900;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  padding-left: 18rpx;
  align-items: flex-end;
  background: rgba(251, 251, 250, .98);
  border-bottom: 1rpx solid #e8eae7;
  box-sizing: border-box;
}

.directory-button {
  position: absolute;
  z-index: 1;
  bottom: 0;
  left: 18rpx;
  display: flex;
  width: 72rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-radius: 6rpx;
}

.directory-button-pressed { background: #eceeeb; }
.directory-button image { width: 34rpx; height: 34rpx; opacity: .78; }

.knowledge-nav-title {
  position: absolute;
  right: 50%;
  bottom: 0;
  width: 300rpx;
  color: #202420;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translateX(50%);
  pointer-events: none;
}

.channel-tabs {
  position: relative;
  z-index: 20;
  display: flex;
  height: 86rpx;
  padding: 0 14rpx 0 20rpx;
  align-items: stretch;
  background: rgba(251, 251, 250, .98);
  border-bottom: 1rpx solid #e4e7e4;
  box-sizing: border-box;
}

.channel-tab {
  position: relative;
  display: flex;
  min-width: 0;
  padding: 0 8rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #858b87;
  font-size: 20rpx;
  white-space: nowrap;
}

.channel-tab-active { color: #222723; font-weight: 800; }
.channel-tab > view {
  position: absolute;
  right: 22rpx;
  bottom: 0;
  left: 22rpx;
  height: 5rpx;
  opacity: 0;
  background: #2e8da6;
  border-radius: 5rpx 5rpx 0 0;
}
.channel-tab-active > view { opacity: 1; }

.search-button {
  position: relative;
  width: 64rpx;
  flex: 0 0 64rpx;
}
.search-button::before {
  position: absolute;
  top: 28rpx;
  left: 17rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #656d68;
  border-radius: 50%;
  content: "";
  box-sizing: border-box;
}
.search-button::after {
  position: absolute;
  top: 47rpx;
  left: 36rpx;
  width: 13rpx;
  height: 3rpx;
  background: #656d68;
  border-radius: 2rpx;
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-panel {
  padding: 14rpx 28rpx;
  background: rgba(251, 251, 250, .98);
  border-bottom: 1rpx solid #e5e7e4;
}
.search-field {
  position: relative;
  display: grid;
  height: 70rpx;
  padding-left: 54rpx;
  align-items: center;
  background: #eceeeb;
  border-radius: 7rpx;
  grid-template-columns: minmax(0, 1fr) 78rpx;
  box-sizing: border-box;
}
.search-field input { height: 100%; font-size: 22rpx; }
.search-field > text { color: #5d6660; font-size: 21rpx; text-align: center; }
.search-mark {
  position: absolute;
  top: 23rpx;
  left: 21rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #7c847f;
  border-radius: 50%;
  box-sizing: border-box;
}
.search-mark::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 3rpx;
  background: #7c847f;
  content: "";
  transform: rotate(45deg);
}

.deck-meta {
  display: flex;
  min-height: 92rpx;
  padding: 20rpx 34rpx 14rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.deck-meta > view:first-child text { display: block; }
.deck-meta > view:first-child text:first-child { color: #333834; font-size: 24rpx; font-weight: 800; }
.deck-meta > view:first-child text:last-child { margin-top: 3rpx; color: #969c97; font-size: 17rpx; }
.deck-meta > view:last-child { color: #858c87; font-size: 19rpx; }

.card-deck {
  height: calc(100vh - 420rpx - env(safe-area-inset-bottom));
  min-height: 720rpx;
  max-height: 960rpx;
}
.card-deck-search { height: calc(100vh - 510rpx - env(safe-area-inset-bottom)); min-height: 650rpx; }
.card-deck swiper-item { box-sizing: border-box; }

.knowledge-card {
  display: flex;
  height: calc(100% - 24rpx);
  margin: 0 12rpx 24rpx;
  padding: 24rpx 26rpx 0;
  overflow: hidden;
  flex-direction: column;
  background: linear-gradient(145deg, rgba(255, 255, 255, .99) 0%, rgba(247, 249, 247, .97) 100%);
  border: 1rpx solid #dbe1dc;
  border-top-color: #ffffff;
  border-bottom-color: #ccd4cd;
  border-radius: 8rpx;
  box-shadow: none;
  box-sizing: border-box;
  transition: background-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
}
.knowledge-card:active { background: #f1f3f0; border-top-color: #d4dad5; border-bottom-color: #eef1ee; box-shadow: none; transform: translateY(2rpx); }
.knowledge-card-recitation { border-top: 5rpx solid #a87922; background: #fffefb; }
.card-topline, .card-source, .card-actions, .sheet-head, .feature-row { display: flex; align-items: center; }
.card-topline, .card-source, .sheet-head { justify-content: space-between; }
.card-topline { min-height: 42rpx; color: #929893; font-size: 18rpx; }
.card-type {
  padding: 6rpx 10rpx;
  color: #31724e;
  background: #e3f3e8;
  border-radius: 4rpx;
  font-size: 17rpx;
  font-weight: 800;
}
.type-recitation { color: #916000; background: #fff0c2; }
.type-community { color: #326a8b; background: #e1f0f7; }
.type-personal { color: #6c547b; background: #eee7f3; }

.cover-wrap { display: flex; min-height: 262rpx; align-items: center; justify-content: center; }
.card-cover {
  display: flex;
  width: 218rpx;
  height: 218rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, .34);
  border-radius: 50%;
  box-shadow: none;
}
.card-cover text { font-family: serif; font-size: 72rpx; font-weight: 800; line-height: 1; }
.card-cover view {
  width: 172rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, .84);
  font-size: 16rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cover-cyan { background: #3a8190; }
.cover-ink { background: #353a3d; }
.cover-rose { background: #9a5a60; }
.cover-green { background: #4d765d; }
.cover-violet { background: #675d7c; }
.card-title { color: #1f2320; font-size: 31rpx; font-weight: 900; line-height: 1.4; text-align: center; }
.card-subtitle { margin-top: 7rpx; color: #858b87; font-size: 19rpx; line-height: 1.45; text-align: center; }
.card-summary {
  display: -webkit-box;
  margin-top: 18rpx;
  overflow: hidden;
  flex: 1;
  color: #555d58;
  font-size: 20rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.recitation-heading { padding: 30rpx 0 20rpx; text-align: center; }
.recitation-heading > text { color: #9a6b18; font-size: 17rpx; font-weight: 850; }
.recitation-heading .card-title { margin-top: 11rpx; font-family: serif; font-size: 38rpx; }
.recitation-heading .card-subtitle { margin-top: 8rpx; }
.recitation-lines {
  display: flex;
  min-height: 250rpx;
  padding: 24rpx 12rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid #dfd8c9;
  border-bottom: 1rpx solid #dfd8c9;
  box-sizing: border-box;
}
.recitation-lines text { display: block; color: #343630; font-family: serif; font-size: 24rpx; line-height: 2.05; text-align: center; }
.recitation-meta { display: flex; min-height: 55rpx; align-items: center; justify-content: space-between; color: #948a78; font-size: 17rpx; }

.card-source { min-height: 58rpx; color: #919792; border-top: 1rpx solid #e9ece9; font-size: 17rpx; }
.card-actions { height: 72rpx; margin: 0 -26rpx; flex: 0 0 72rpx; border-top: 1rpx solid #e7eae7; }
.card-action { display: flex; height: 100%; flex: 1; align-items: center; justify-content: center; color: #9da29e; font-size: 18rpx; gap: 9rpx; }
.action-active { color: #2885a5; }
.bookmark-icon { width: 20rpx; height: 27rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 3rpx 3rpx 0 0; box-sizing: border-box; clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 75%, 0 100%); }
.comment-icon { position: relative; width: 27rpx; height: 21rpx; border: 3rpx solid currentColor; border-radius: 5rpx; box-sizing: border-box; }
.comment-icon::after { position: absolute; bottom: -7rpx; left: 5rpx; width: 8rpx; height: 8rpx; border-left: 3rpx solid currentColor; content: ""; transform: skewY(-40deg); }
.heart-icon { font-size: 31rpx; line-height: 1; }

.community-view { padding: 18rpx 28rpx 40rpx; }
.community-intro, .asset-head, .asset-foot { display: flex; align-items: center; justify-content: space-between; }
.community-intro { padding: 8rpx 2rpx 16rpx; }
.community-intro > view:first-child text { display: block; }
.community-intro > view:first-child text:first-child { color: #252925; font-size: 26rpx; font-weight: 900; }
.community-intro > view:first-child text:last-child { margin-top: 4rpx; color: #8a908b; font-size: 18rpx; }
.community-intro > view:last-child { color: #7c847f; font-size: 19rpx; }
.community-type-scroll { width: 100%; margin-bottom: 18rpx; white-space: nowrap; }
.community-types { display: inline-flex; padding: 0 2rpx; gap: 12rpx; }
.community-type { padding: 11rpx 20rpx; color: #707772; background: #e7eae7; border-radius: 999rpx; font-size: 19rpx; }
.community-type-active { color: #fff; background: #3e4641; }
.community-asset { margin-bottom: 22rpx; padding: 22rpx; background: linear-gradient(145deg, rgba(255, 255, 255, .99) 0%, rgba(247, 249, 247, .97) 100%); border: 1rpx solid #dce2dd; border-top-color: #ffffff; border-bottom-color: #cfd6d0; border-radius: 8rpx; box-shadow: none; transition: background-color 120ms ease, transform 120ms ease; }
.community-asset:active { background: #f1f3f0; border-top-color: #d4dad5; border-bottom-color: #eef1ee; box-shadow: none; transform: translateY(2rpx); }
.asset-head { color: #898f8a; font-size: 18rpx; }
.asset-type { padding: 6rpx 10rpx; color: #31724e; background: #e2f3e7; border-radius: 4rpx; font-weight: 800; }
.asset-type-question, .asset-type-question_pack { color: #326c8d; background: #e0f0f7; }
.asset-type-card_pack { color: #8e6100; background: #fff0c5; }
.asset-title { margin-top: 16rpx; color: #252925; font-size: 27rpx; font-weight: 900; line-height: 1.45; }
.asset-excerpt { display: -webkit-box; margin-top: 9rpx; overflow: hidden; color: #616964; font-size: 21rpx; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.asset-path { margin-top: 12rpx; overflow: hidden; color: #3c7890; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.asset-tags { display: flex; margin-top: 10rpx; flex-wrap: wrap; gap: 8rpx; }
.asset-tags text { color: #858c87; font-size: 17rpx; }
.asset-foot { min-height: 76rpx; margin-top: 15rpx; padding-top: 14rpx; border-top: 1rpx solid #e9ece9; }
.asset-foot > view { display: flex; color: #919792; font-size: 17rpx; gap: 16rpx; }
.asset-foot button { height: 60rpx; margin: 0; padding: 0 16rpx; color: #fff; background: #3f4440; border-radius: 6rpx; font-size: 18rpx; line-height: 60rpx; }
.community-empty { padding: 100rpx 20rpx; color: #909691; font-size: 21rpx; text-align: center; }

.library-browser-head {
  position: relative;
  z-index: 120;
  background: rgba(251, 251, 250, .98);
}
.library-toolbar {
  display: flex;
  width: 100%;
  height: 94rpx;
  min-height: 94rpx;
  padding: 0 22rpx 0 30rpx;
  align-items: center;
  justify-content: space-between;
  background: rgba(251, 251, 250, .98);
  border-bottom: 1rpx solid #e3e6e3;
  box-sizing: border-box;
}
.library-toolbar-title {
  display: flex;
  min-width: 0;
  height: 94rpx;
  flex: 1 1 auto;
  align-items: center;
  overflow: hidden;
  white-space: nowrap;
}
.library-toolbar-title text, .library-toolbar-title label { display: block; white-space: nowrap; }
.library-toolbar-title text { color: #252925; font-size: 27rpx; font-weight: 900; }
.library-toolbar-title label { margin-left: 14rpx; color: #929894; font-size: 17rpx; }
.library-tools { display: flex; width: 198rpx; height: 94rpx; flex: 0 0 198rpx; align-items: center; justify-content: space-between; }
.library-tool { display: flex; width: 62rpx; min-width: 62rpx; max-width: 62rpx; height: 62rpx; flex: 0 0 62rpx; align-items: center; justify-content: center; background: transparent; border-radius: 50%; box-sizing: border-box; }
.library-tool:active { background: #e8efed; }
.library-tool image { width: 30rpx; height: 30rpx; opacity: .8; }
.library-inline-menu {
  position: absolute;
  z-index: 20;
  top: 82rpx;
  right: 82rpx;
  width: 286rpx;
  padding: 6rpx 12rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, .98);
  border: 1rpx solid #dfe4df;
  border-radius: 8rpx;
  box-shadow: 0 12rpx 28rpx rgba(46, 55, 49, .14);
  box-sizing: border-box;
}
.library-filter-menu { right: 20rpx; width: 350rpx; max-height: 430rpx; overflow-y: auto; }
.library-feed { padding: 22rpx 28rpx 40rpx; }
.library-card {
  position: relative;
  display: grid;
  min-height: 238rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 44rpx 22rpx 20rpx;
  align-items: center;
  background: linear-gradient(145deg, rgba(255, 255, 255, .99) 0%, rgba(247, 249, 247, .97) 100%);
  border: 1rpx solid #dbe1dc;
  border-top-color: #ffffff;
  border-bottom-color: #ccd4cd;
  border-radius: 8rpx;
  box-shadow: none;
  grid-template-columns: 116rpx minmax(0, 1fr);
  gap: 20rpx;
  box-sizing: border-box;
  transition: background-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
}
.library-card:active { background: #f1f3f0; border-top-color: #d4dad5; border-bottom-color: #eef1ee; box-shadow: none; transform: translateY(2rpx); }
.library-cover { display: flex; width: 108rpx; height: 108rpx; align-items: center; justify-content: center; color: #fff; border: 1rpx solid rgba(255, 255, 255, .34); border-radius: 50%; box-shadow: none; }
.library-cover text { font-family: serif; font-size: 42rpx; font-weight: 850; }
.library-card-recitation { grid-template-columns: 84rpx minmax(0, 1fr); background: #fffefb; border-left: 5rpx solid #aa7b25; }
.library-cover-recitation { width: 76rpx; height: 132rpx; border-radius: 4rpx; }
.library-card-copy { min-width: 0; }
.library-card-head, .library-card-foot { display: flex; align-items: center; justify-content: space-between; }
.library-card-head label { color: #979d98; font-size: 17rpx; }
.library-card-title { margin-top: 12rpx; color: #252925; font-size: 27rpx; font-weight: 900; line-height: 1.4; }
.library-card-summary { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #646b66; font-size: 19rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.library-card-foot { margin-top: 12rpx; color: #929893; font-size: 16rpx; }
.library-card-foot text { max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.library-chevron { position: absolute; top: 50%; right: 20rpx; width: 12rpx; height: 12rpx; border-top: 3rpx solid #a1a7a2; border-right: 3rpx solid #a1a7a2; transform: translateY(-50%) rotate(45deg); }

.empty-state { margin: 70rpx 28rpx; padding: 70rpx 24rpx; color: #303430; background: rgba(255, 255, 255, .82); border-radius: 8rpx; font-size: 25rpx; text-align: center; }
.empty-state text { display: block; margin-top: 9rpx; color: #8a908b; font-size: 20rpx; }

.knowledge-directory-layer { position: fixed; z-index: 2000; top: 0; right: 0; bottom: 0; left: 0; visibility: hidden; pointer-events: none; }
.knowledge-directory-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: 0; background: rgba(20, 22, 20, .34); transition: opacity 210ms ease; }
.knowledge-directory { position: absolute; top: 0; bottom: 0; left: 0; display: flex; width: 82%; max-width: 650rpx; flex-direction: column; background: #fbfbfa; border-radius: 0 16rpx 16rpx 0; transform: translateX(-102%); transition: transform 240ms ease; box-sizing: border-box; }
.knowledge-directory-visible { visibility: visible; pointer-events: auto; }
.knowledge-directory-visible .knowledge-directory-mask { opacity: 1; }
.knowledge-directory-visible .knowledge-directory { transform: translateX(0); }
.directory-head { display: flex; min-height: 116rpx; padding: 20rpx 26rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e8ebe8; box-sizing: border-box; }
.directory-head text, .directory-head label { display: block; }
.directory-head text { color: #202420; font-size: 31rpx; font-weight: 900; }
.directory-head label { margin-top: 4rpx; color: #909691; font-size: 18rpx; }
.directory-close { position: relative; width: 62rpx; height: 62rpx; flex: 0 0 62rpx; background: #eceeeb; border-radius: 50%; box-sizing: border-box; }
.directory-close-line { position: absolute; top: 50%; left: 50%; width: 24rpx; height: 2rpx; background: #59605b; border-radius: 2rpx; transform-origin: center; }
.directory-close-line-a { transform: translate(-50%, -50%) rotate(45deg); }
.directory-close-line-b { transform: translate(-50%, -50%) rotate(-45deg); }
.directory-tools { display: grid; min-height: 88rpx; padding: 10rpx 24rpx; border-bottom: 1rpx solid #e8ebe8; grid-template-columns: repeat(3, 1fr); box-sizing: border-box; }
.directory-tools > view { display: flex; min-width: 0; align-items: center; justify-content: center; color: #626a65; font-size: 18rpx; gap: 10rpx; }
.directory-tools image { width: 27rpx; height: 27rpx; opacity: .78; }
.directory-sort-icon { display: flex; width: 28rpx; height: 26rpx; flex-direction: column; justify-content: center; gap: 4rpx; }
.directory-sort-icon text { display: block; height: 3rpx; background: #626a65; border-radius: 2rpx; }
.directory-sort-icon text:nth-child(1) { width: 27rpx; }
.directory-sort-icon text:nth-child(2) { width: 20rpx; }
.directory-sort-icon text:nth-child(3) { width: 13rpx; }
.directory-inline-menu { max-height: 360rpx; padding: 6rpx 24rpx; overflow-y: auto; background: #f5f7f4; border-bottom: 1rpx solid #e2e6e2; box-sizing: border-box; }
.directory-filter-menu { max-height: 430rpx; }
.directory-menu-option { display: flex; min-height: 64rpx; padding: 0 10rpx; align-items: center; justify-content: space-between; color: #5c645f; border-bottom: 1rpx solid #e7eae7; font-size: 20rpx; }
.directory-menu-option:last-child { border-bottom: 0; }
.directory-menu-active { color: #1c7891; font-weight: 800; }
.directory-menu-active label { color: #1c91b0; }
.directory-scroll { min-height: 0; padding: 24rpx 24rpx 60rpx; flex: 1; box-sizing: border-box; }
.directory-home { display: grid; min-height: 116rpx; padding: 18rpx; grid-template-columns: 58rpx minmax(0, 1fr) 20rpx; align-items: center; background: #f0f2ef; border: 1rpx solid #e5e8e5; border-radius: 8rpx; box-sizing: border-box; }
.directory-home-active { background: #eaf6f8; border-color: #cae7ed; }
.directory-home-mark, .directory-item-mark { display: flex; width: 46rpx; height: 52rpx; align-items: center; justify-content: center; color: #176d87; background: #dff3f7; border-radius: 5rpx; font-size: 20rpx; font-weight: 900; }
.directory-home text, .directory-home label, .directory-item text, .directory-item label { display: block; }
.directory-home text { color: #252925; font-size: 25rpx; font-weight: 900; }
.directory-home label { margin-top: 5rpx; color: #7f8681; font-size: 18rpx; }
.directory-section-title { padding: 30rpx 4rpx 12rpx; color: #949a95; font-size: 19rpx; }
.directory-item { display: grid; min-height: 104rpx; padding: 14rpx 16rpx; grid-template-columns: 58rpx minmax(0, 1fr) 20rpx; align-items: center; border-bottom: 1rpx solid #e9ece9; box-sizing: border-box; }
.directory-item-active { color: #176d87; background: #edf7f9; border-radius: 7rpx; }
.directory-item-mark { color: #5e6661; background: #eceeeb; }
.directory-item-active .directory-item-mark { color: #176d87; background: #dff3f7; }
.directory-item text { color: #2d322e; font-size: 23rpx; font-weight: 850; }
.directory-item label { margin-top: 4rpx; color: #89908b; font-size: 17rpx; }
.directory-chevron { width: 12rpx; height: 12rpx; border-top: 3rpx solid #9aa09b; border-right: 3rpx solid #9aa09b; transform: rotate(45deg); }

.detail-mask { position: fixed; z-index: 2100; top: 0; right: 0; bottom: 0; left: 0; background: rgba(25, 28, 26, .42); }
.detail-sheet { position: fixed; z-index: 2110; right: 0; bottom: 0; left: 0; height: 76vh; padding: 0 30rpx env(safe-area-inset-bottom); background: #fbfbfa; border-radius: 18rpx 18rpx 0 0; box-sizing: border-box; }
.sheet-handle { width: 76rpx; height: 8rpx; margin: 14rpx auto 18rpx; background: #ced2ce; border-radius: 4rpx; }
.sheet-head { min-height: 90rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #e4e7e4; }
.sheet-head > view:first-child > text { color: #3482a0; font-size: 18rpx; font-weight: 800; }
.sheet-head > view:first-child > view { margin-top: 5rpx; color: #252925; font-size: 32rpx; font-weight: 900; }
.sheet-close { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; color: #69706b; font-size: 42rpx; }
.sheet-content { height: calc(76vh - 383rpx - env(safe-area-inset-bottom)); }
.detail-summary { padding: 25rpx 0; color: #4d554f; font-size: 23rpx; line-height: 1.75; }
.detail-section { padding: 22rpx 0; border-top: 1rpx solid #e6e9e6; }
.detail-title { margin-bottom: 14rpx; color: #303530; font-size: 23rpx; font-weight: 900; }
.quote-row { margin-top: 10rpx; padding: 17rpx 18rpx; color: #3f4641; background: #f0f3f0; border-left: 5rpx solid #52a9c6; font-size: 21rpx; line-height: 1.65; }
.feature-row { margin-top: 14rpx; align-items: flex-start; color: #4d554f; font-size: 22rpx; line-height: 1.6; }
.feature-row > text { display: flex; width: 36rpx; height: 36rpx; margin-right: 12rpx; flex: 0 0 36rpx; align-items: center; justify-content: center; color: #286a83; background: #dff1f7; border-radius: 50%; font-size: 17rpx; font-weight: 850; }
.detail-action-bar { position: absolute; right: 30rpx; bottom: calc(118rpx + env(safe-area-inset-bottom)); left: 30rpx; height: 120rpx; padding: 18rpx 0 22rpx; background: #fbfbfa; border-top: 1rpx solid #e5e8e5; box-sizing: border-box; }
.review-add { display: flex; width: 100%; height: 80rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: #fff; background: #303330; border-radius: 8rpx; font-size: 23rpx; font-weight: 800; line-height: normal; box-sizing: border-box; }
.review-add[disabled] { color: #717873; background: #e4e7e4; }

.asset-detail-sheet {
  position: fixed;
  z-index: 2120;
  right: 0;
  bottom: 0;
  left: 0;
  height: 78vh;
  padding: 0 30rpx env(safe-area-inset-bottom);
  background: #fbfbfa;
  border-radius: 18rpx 18rpx 0 0;
  box-sizing: border-box;
}
.asset-detail-head { display: flex; min-height: 94rpx; padding-bottom: 16rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e4e7e4; }
.asset-detail-head > view:first-child { min-width: 0; padding-right: 18rpx; }
.asset-detail-head > view:first-child > text { color: #3482a0; font-size: 18rpx; font-weight: 800; }
.asset-detail-head > view:first-child > view { margin-top: 5rpx; overflow: hidden; color: #252925; font-size: 30rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.asset-detail-scroll { height: calc(78vh - 150rpx - env(safe-area-inset-bottom)); }
.asset-detail-byline { display: flex; min-height: 72rpx; align-items: center; justify-content: space-between; color: #8a918c; border-bottom: 1rpx solid #e8ebe8; font-size: 18rpx; }
.asset-detail-byline text { max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-detail-byline text:last-child { color: #3c7890; text-align: right; }
.asset-detail-content { padding: 24rpx 0; color: #454d48; font-size: 23rpx; line-height: 1.8; white-space: pre-wrap; }
.asset-detail-tags { display: flex; padding-bottom: 22rpx; flex-wrap: wrap; gap: 8rpx; }
.asset-detail-tags text { padding: 7rpx 10rpx; color: #596e78; background: #e7f0f3; border-radius: 4rpx; font-size: 18rpx; }
.asset-question-section { padding: 22rpx 0; border-top: 1rpx solid #e4e7e4; }
.asset-question-title { display: flex; margin-bottom: 12rpx; align-items: center; justify-content: space-between; }
.asset-question-title text { color: #303530; font-size: 23rpx; font-weight: 900; }
.asset-question-title label { color: #8b928d; font-size: 18rpx; }
.asset-question-row { display: grid; min-height: 92rpx; padding: 15rpx 0; align-items: flex-start; border-bottom: 1rpx solid #e8ebe8; grid-template-columns: 42rpx minmax(0, 1fr); }
.asset-question-row > text { display: flex; width: 32rpx; height: 32rpx; align-items: center; justify-content: center; color: #39758a; background: #e2f0f4; border-radius: 50%; font-size: 16rpx; font-weight: 800; }
.asset-question-row label { color: #818984; font-size: 17rpx; }
.asset-question-row > view > view { margin-top: 5rpx; color: #3f4641; font-size: 21rpx; line-height: 1.55; }
.asset-question-empty { padding: 28rpx 10rpx; color: #8b928d; background: #f1f3f0; border-radius: 7rpx; font-size: 19rpx; line-height: 1.6; text-align: center; }
.asset-detail-action { height: 80rpx; margin: 24rpx 0 38rpx; color: #fff; background: #303330; border-radius: 8rpx; font-size: 23rpx; font-weight: 800; line-height: 80rpx; }
.asset-detail-action[disabled] { color: #717873; background: #e4e7e4; }
