<view class="page-shell tab-page discover-page">
  <scroll-view class="channel-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="channel-row">
      <view class="channel {{activeChannel === item.id ? 'channel-active' : ''}}" wx:for="{{channels}}" wx:key="id" data-id="{{item.id}}" bindtap="selectChannel">{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="discover-spotlight">
    <view class="spotlight-copy">
      <view class="spotlight-label">薯考精选</view>
      <view class="spotlight-title">把知识点拆开练，把进度看得见</view>
      <view class="spotlight-meta">题库 · 练习记录 · 学习工具</view>
    </view>
    <image src="/assets/potato-ai.png" mode="aspectFit" />
  </view>

  <view class="section-heading">
    <view class="section-title">题库与工具</view>
    <text>{{visibleProducts.length}} 项</text>
  </view>
  <scroll-view class="product-scroll" scroll-x="true" enhanced="true" show-scrollbar="false" wx:if="{{visibleProducts.length}}">
    <view class="product-row">
      <view class="product-card" wx:for="{{visibleProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
        <view class="product-cover product-cover-{{item.accent}}">
          <text>{{item.kindLabel}}</text>
          <view>{{item.kind === 'course' ? '课' : '资'}}</view>
        </view>
        <view class="product-title">{{item.title}}</view>
        <view class="product-subtitle">{{item.subtitle}}</view>
        <view class="product-foot"><text>{{item.priceLabel}}</text><label>{{item.badge}}</label></view>
      </view>
    </view>
  </scroll-view>
  <view class="discover-empty" wx:elif="{{!loading}}">该分类内容正在准备。</view>

  <view class="section-heading learning-heading">
    <view class="section-title">更多学习方式</view>
  </view>
  <view class="entrance-list">
    <view class="entrance-row" wx:for="{{entrances}}" wx:key="id" data-id="{{item.id}}" bindtap="openEntrance">
      <view class="entrance-icon entrance-icon-{{item.icon}}"><view></view></view>
      <view class="entrance-main"><view>{{item.title}}</view><text>{{item.subtitle}}</text></view>
      <label>{{item.status}}</label>
      <view class="entrance-chevron"></view>
    </view>
  </view>

  <view class="future-slot">
    <view class="future-plus">+</view>
    <view><view>更多</view><text>新的学习工具会继续加入这里</text></view>
  </view>

  <view class="product-layer" wx:if="{{detailOpen}}" bindtap="closeProduct">
    <view class="product-dialog" catchtap="stopPropagation">
      <view class="dialog-cover product-cover-{{selectedProduct.accent}}"><text>{{selectedProduct.kindLabel}}</text><view>{{selectedProduct.kind === 'course' ? '课' : '资'}}</view></view>
      <view class="dialog-content">
        <view class="dialog-badge">{{selectedProduct.badge}}</view>
        <view class="dialog-title">{{selectedProduct.title}}</view>
        <view class="dialog-subtitle">{{selectedProduct.subtitle}}</view>
        <view class="dialog-description">{{selectedProduct.description}}</view>
        <view class="dialog-action-row">
          <view><text>{{selectedProduct.priceLabel}}</text><label>支付功能下一阶段开放</label></view>
          <button bindtap="reserveProduct">{{selectedProductReserved ? '取消提醒' : '开售提醒'}}</button>
        </view>
      </view>
      <view class="dialog-close" bindtap="closeProduct" role="button" aria-label="关闭">×</view>
    </view>
  </view>
</view>
