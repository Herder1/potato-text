.collection-page { min-height: 100vh; color: #202824; background: #f7f8f6; box-sizing: border-box; }
.collection-nav { position: fixed; z-index: 30; top: 0; right: 0; left: 0; display: flex; padding-left: 18rpx; align-items: flex-end; background: rgba(247,248,246,.98); border-bottom: 1rpx solid #e5e9e6; box-sizing: border-box; }
.nav-leading { position: absolute; bottom: 0; left: 18rpx; display: flex; width: 136rpx; height: 76rpx; align-items: center; }
.nav-leading .nav-icon, .nav-leading .nav-directory { margin-right: 0; margin-left: 0; }
.nav-icon { display: flex; width: 68rpx; height: 72rpx; margin: 0; padding: 0; flex: 0 0 68rpx; align-items: center; justify-content: center; color: #364039; background: transparent; border: 0; line-height: 1; }
.nav-icon::after { display: none; }
.nav-icon image { width: 32rpx; height: 32rpx; }
.nav-icon text { color: #59635d; font-size: 28rpx; font-weight: 800; letter-spacing: 3rpx; }
.nav-directory { display: flex; width: 68rpx; height: 72rpx; margin: 0; padding: 0; flex: 0 0 68rpx; align-items: center; justify-content: center; color: #4f5b54; background: transparent; border: 0; border-radius: 32rpx; line-height: 1; }
.nav-directory::after { display: none; }
.nav-directory image { width: 32rpx; height: 32rpx; }
.collection-main { padding: 34rpx 30rpx calc(220rpx + env(safe-area-inset-bottom)); }
.collection-hero { display: flex; padding: 8rpx 0 22rpx; align-items: flex-start; gap: 18rpx; }
.hero-mark { display: flex; width: 72rpx; height: 72rpx; flex: 0 0 72rpx; align-items: center; justify-content: center; color: #fff; background: #0b9588; border-radius: 8rpx; font-size: 32rpx; font-weight: 850; }
.hero-copy { min-width: 0; flex: 1; }
.hero-kicker { color: #77837b; font-size: 18rpx; line-height: 1.5; }
.hero-title { margin-top: 6rpx; color: #202824; font-size: 34rpx; font-weight: 850; line-height: 1.35; }
.hero-description { margin-top: 9rpx; color: #68756d; font-size: 21rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
/* DEC-084：按产品负责人要求去掉「可用题目 / 已删除 / 作者」这一行统计。 */
.type-line { color: #65736b; font-size: 19rpx; line-height: 1.5; }
.tag-line { display: flex; margin-top: 12rpx; flex-wrap: wrap; gap: 8rpx; }
.tag-line text { padding: 5rpx 10rpx; color: #2a6dbf; background: #edf4ff; border-radius: 4rpx; font-size: 16rpx; line-height: 1.3; }

/* ── 目录 + 双列卡片：与知识卡卡集页同一套（DEC-070 借用）── */
.section { position: relative; margin-top: 18rpx; }
.section-level-block-1 { margin-top: 24rpx; }
.section-level-block-2 { margin-top: 14rpx; }
.section-level-block-3 { margin-top: 12rpx; }
.section-title { position: relative; z-index: 2; padding: 0 4rpx; color: #303934; font-size: 25rpx; font-weight: 750; line-height: 1.35; }
.section-title text { margin-left: 12rpx; color: #929b95; font-size: 17rpx; font-weight: 400; }
.section-with-cards .section-title { padding-bottom: 12rpx; }
.section-level-2 { font-size: 23rpx; font-weight: 700; }
.section-level-3 { font-size: 21rpx; font-weight: 650; }
.section-title-active { padding: 14rpx 16rpx; color: #237fb2; background: #eaf5ff; border: 2rpx solid #2f9fff; border-radius: 8rpx; box-sizing: border-box; }
.section-title-active text { color: #5f8ba3; }
/* DEC-060：新建目录/改名直接在目录行里输入名称。 */
.section-title-input { margin: 0 4rpx 8rpx; padding: 6rpx 16rpx; color: #2b342f; background: #f2f7f5; border: 2rpx solid #bfe3da; border-radius: 12rpx; font-size: 25rpx; font-weight: 750; line-height: 1.4; box-sizing: border-box; }
.card-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16rpx; }
/* DEC-087：卡片块从标题块里拆出来（子目录先渲染、本目录卡片后渲染），间距仍由标题的 padding-bottom 提供 */
.section-cards { position: relative; margin-top: 0; }
/* DEC-089：两个卡片块直接相邻时（父目录的卡片排在子目录卡片之后 / 空目录标题之后）要补回组间间距，
   否则两个 grid 会贴在一起，看起来"间距不一致"。 */
.section-cards + .section-cards { margin-top: 16rpx; }
.section.section-empty + .section-cards { margin-top: 12rpx; }
.study-card { position: relative; z-index: 2; display: flex; min-height: 218rpx; padding: 18rpx; flex-direction: column; background: #fff; border: 1rpx solid #e7ece9; border-radius: 16rpx; box-shadow: inset 0 2rpx 0 rgba(255,255,255,.9), inset 2rpx 0 0 rgba(255,255,255,.5); box-sizing: border-box; }
.study-card::before { position: absolute; z-index: 1; top: 13rpx; left: 13rpx; width: 22rpx; height: 22rpx; background: #f4f6f4; border: 2rpx solid #d9e0dc; border-radius: 50%; box-shadow: inset 0 1rpx 3rpx rgba(35,55,44,.13); content: ""; box-sizing: border-box; }
.study-card.selected { border: 3rpx solid #2f9fff; box-shadow: 0 5rpx 16rpx rgba(47,159,255,.12); }
.study-card.selected::before { border-color: #2f9fff; }
.card-tag { padding-left: 30rpx; color: #0b9588; font-size: 17rpx; }
.study-title { display: -webkit-box; margin-top: 19rpx; overflow: hidden; color: #28312b; font-size: 23rpx; font-weight: 750; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.study-answer { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #7b8780; font-size: 17rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.study-foot { display: flex; margin-top: auto; padding-top: 14rpx; justify-content: space-between; color: #919b95; font-size: 16rpx; }
.study-foot text:first-child { color: #0b9588; }
.study-card-blank .study-title { color: #9aa39d; font-weight: 600; }
.study-card-deleted { opacity: .72; }
.study-card-deleted .study-foot text:first-child { color: #b6534c; }

/* 拖拽：原位虚化 + 浮起幽灵 + 蓝色落点提示（对齐 DEC-052） */
.study-card-drag-origin { border: 2rpx dashed #b9c6d4; background: #f7f9fb; opacity: .4; }
.title-drag-origin { border: 2rpx dashed #b9c6d4; background: #f7f9fb; border-radius: 10rpx; opacity: .4; }
.drag-ghost { position: fixed; z-index: 60; pointer-events: none; transform: scale(1.05); transform-origin: center center; }
.drag-ghost-card { display: flex; padding: 18rpx; flex-direction: column; background: #fff; border: 2rpx solid #2f9fff; border-radius: 16rpx; box-shadow: 0 20rpx 42rpx rgba(31,48,38,.24); box-sizing: border-box; }
.drag-ghost-title { padding: 14rpx 16rpx; color: #1d6fae; background: #eaf5ff; border-radius: 10rpx; box-shadow: 0 14rpx 30rpx rgba(47,159,255,.26); font-size: 25rpx; font-weight: 750; line-height: 1.35; box-sizing: border-box; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.drag-indicator { position: fixed; z-index: 1; background: #2f9fff; border-radius: 4rpx; pointer-events: none; box-shadow: 0 0 0 2rpx rgba(47,159,255,.25); }

/* 长按后的深色操作栏（DEC-051 同一视觉） */
.context-toolbar { position: fixed; z-index: 35; display: flex; height: 96rpx; padding: 0 12rpx; align-items: center; justify-content: space-around; color: #fff; background: #2d322f; border-radius: 16rpx; box-shadow: 0 8rpx 24rpx rgba(28,39,33,.2); box-sizing: border-box; }
.context-toolbar-cards { right: 28rpx; }
.context-toolbar-directory { left: 50%; width: 556rpx; transform: translateX(-50%); }
.context-toolbar > view { display: flex; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; flex-direction: column; color: #fff; border-radius: 10rpx; gap: 4rpx; }
.context-toolbar > view:active { background: rgba(255,255,255,.1); }
.context-toolbar image { display: block; width: 30rpx; height: 30rpx; }
.context-toolbar label { display: block; color: #fff; font-size: 15rpx; line-height: 1.2; }
/* DEC-083：「标题级别」角标随当前目录级别变化（H1/H2/H3） */
.context-toolbar .toolbar-level-mark { display: flex; width: 30rpx; height: 30rpx; align-items: center; justify-content: center; color: #fff; font-size: 22rpx; font-weight: 800; line-height: 1; }
.context-toolbar-directory > view { width: 78rpx; }
/* 深色圆角菜单（DEC-051）：跟随操作栏出现，点外部关闭。 */
.context-menu-layer { position: fixed; z-index: 70; top: 0; right: 0; bottom: 0; left: 0; }
.context-menu { position: absolute; min-width: 300rpx; max-width: 560rpx; max-height: 560rpx; padding: 10rpx 0; overflow-y: auto; background: #2d322f; border-radius: 16rpx; box-shadow: 0 14rpx 34rpx rgba(18,24,20,.34); box-sizing: border-box; }
.context-menu-center { left: 50%; transform: translateX(-50%); }
.context-menu-right { right: 28rpx; }
.context-menu-head { padding: 14rpx 30rpx 10rpx; color: #9aa39d; font-size: 19rpx; }
.context-menu-item { padding: 24rpx 34rpx; color: #fff; font-size: 25rpx; line-height: 1.25; white-space: nowrap; }
.context-menu-item:active { background: rgba(255,255,255,.14); }

/* 卡片上色（DEC-067）：浅色底 + 同色玻璃边；描边由行内 --card-edge 提供 */
.study-card-tinted { border-color: var(--card-edge); }
.study-card-tinted .card-tag { color: #8d938f; }
.study-card-tinted .study-title { color: #333c36; }
.study-card-tinted .study-answer { color: #5f6862; }
.study-card-tinted .study-foot { color: #8d938f; }
.color-picker { position: fixed; z-index: 36; display: grid; padding: 16rpx; grid-template-columns: repeat(5, 64rpx); gap: 16rpx; background: #2d322f; border-radius: 18rpx; box-shadow: 0 10rpx 30rpx rgba(24,35,29,.28); }
.color-picker-right { right: 28rpx; }
.color-dot { width: 64rpx; height: 64rpx; background: #f4f6f4; border: 4rpx solid transparent; border-radius: 50%; box-sizing: border-box; }
.color-dot-none { background: #fff; box-shadow: inset 0 0 0 2rpx #d9e0dc; }
.color-dot-active { border-color: #fff; }
.section-head { display: flex; min-height: 54rpx; align-items: center; justify-content: space-between; }
.section-title { color: #35423a; font-size: 23rpx; font-weight: 800; line-height: 1.45; }
.section-count { color: #8a958e; font-size: 17rpx; line-height: 1.3; }
.question-list { border-top: 1rpx solid #e3e8e5; }
.question-row { display: flex; min-height: 124rpx; padding: 18rpx 0; align-items: flex-start; border-bottom: 1rpx solid #e3e8e5; box-sizing: border-box; gap: 16rpx; }
.question-row-pressed { background: #eef3f0; }
.question-row-selected { background: #eef5ff; }
.question-row-deleted { background: #fffaf3; }
.question-row-blank { background: #f7fbf8; }
.question-number { display: flex; width: 44rpx; height: 44rpx; flex: 0 0 44rpx; align-items: center; justify-content: center; color: #fff; background: #63736a; border-radius: 50%; font-size: 18rpx; font-weight: 800; line-height: 1; }
.question-row-deleted .question-number { color: #9b6b2d; background: #f5dfb9; }
.question-copy { min-width: 0; flex: 1; }
.question-meta { display: flex; min-width: 0; align-items: center; gap: 12rpx; color: #809087; font-size: 16rpx; line-height: 1.3; }
.question-meta text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.question-meta text:first-child { color: #2c74bc; font-weight: 700; }
.question-stem { margin-top: 8rpx; color: #2b352f; font-size: 22rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
.question-row-deleted .question-stem { color: #916b3a; }
.question-row-blank .question-stem { color: #47735d; }
.question-deleted { margin-top: 8rpx; color: #a47b42; font-size: 17rpx; line-height: 1.45; }
.question-chevron { width: 28rpx; flex: 0 0 28rpx; margin-top: 25rpx; color: #a0aaa3; font-size: 34rpx; line-height: 1; text-align: right; }
.outline-empty { padding: 62rpx 0; color: #8a958e; font-size: 20rpx; text-align: center; }
.collection-footer { position: fixed; z-index: 40; right: 48rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); left: 48rpx; display: flex; height: 106rpx; padding: 0 8rpx; align-items: center; justify-content: space-around; background: rgba(255,255,255,.98); border: 0; border-radius: 56rpx; box-shadow: 0 10rpx 30rpx rgba(35,55,44,.14); box-sizing: border-box; }
.collection-footer button { margin: 0; padding: 0; border: 0; background: transparent; }
.collection-footer button::after { display: none; }
.footer-action { display: flex; min-width: 92rpx; height: 86rpx; flex: 1; flex-direction: column; align-items: center; justify-content: center; color: #65726b; border-radius: 44rpx; }
.footer-action-pressed { background: #f0f4f1 !important; }
.footer-action image { display: block; width: 30rpx; height: 30rpx; }
.footer-action text { margin-top: 4rpx; font-size: 17rpx; line-height: 1.2; }
.footer-action .add-mark { display: flex; width: 30rpx; height: 30rpx; margin-top: 0; align-items: center; justify-content: center; color: #59665f; font-size: 31rpx; font-weight: 500; line-height: 1; }
.footer-action .more-mark { height: 30rpx; margin-top: 0; color: #65726b; font-size: 29rpx; line-height: 24rpx; letter-spacing: 3rpx; }
.footer-primary { display: flex; width: 116rpx; height: 86rpx; flex: 0 0 116rpx; align-items: center; justify-content: center; flex-direction: column; color: #fff; background: #19211d !important; border-radius: 44rpx; font-size: 16rpx; font-weight: 800; line-height: 1.2; gap: 3rpx; }
.footer-primary-pressed { opacity: .82; }
.footer-primary[disabled] { color: #a9b1ac; background: #dfe5e1 !important; }
.play-mark { display: flex; width: 28rpx; height: 28rpx; margin: 0; align-items: center; justify-content: center; font-size: 21rpx; line-height: 1; }
.add-layer { position: fixed; z-index: 65; top: 0; right: 0; bottom: 0; left: 0; }
.add-mask { position: absolute; inset: 0; background: rgba(21,30,25,.08); }
/* DEC-050/051：添加菜单改为深色圆角菜单，贴在底部悬浮栏上方。 */
.add-menu { position: absolute; left: 64rpx; bottom: calc(158rpx + env(safe-area-inset-bottom)); display: flex; width: 290rpx; padding: 10rpx; flex-direction: column; align-items: stretch; color: #fff; background: #2d322f; border-radius: 18rpx; box-shadow: 0 8rpx 24rpx rgba(28,39,33,.24); box-sizing: border-box; }
.add-menu-item { display: flex; width: 100%; height: 76rpx; padding: 0 24rpx; align-items: center; color: #fff; border-radius: 12rpx; font-size: 23rpx; font-weight: 600; gap: 10rpx; box-sizing: border-box; }
.add-menu-item text { font-size: 26rpx; }
.add-menu-item label { color: #fff; font-size: 23rpx; }
.add-menu-item + .add-menu-item { border-top: 1rpx solid rgba(255,255,255,.1); }
.add-menu-item:active { background: rgba(255,255,255,.12); }
.more-layer { position: fixed; z-index: 70; top: 0; right: 0; bottom: 0; left: 0; }
.more-mask { position: absolute; inset: 0; background: rgba(24,35,29,.34); }
/* DEC-075：更多改为与知识卡页一致的从底部向上划出的抽屉。 */
.more-drawer { position: absolute; right: 0; bottom: 0; left: 0; max-height: 78vh; overflow-y: auto; padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; animation: drawer-up .24s ease-out; box-sizing: border-box; }
.drawer-head { display: flex; padding-bottom: 24rpx; align-items: center; justify-content: space-between; }
.drawer-head > text:first-child { min-width: 0; overflow: hidden; color: #22201c; font-size: 32rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.drawer-close { flex: 0 0 auto; color: #93998f; font-size: 24rpx; }
.drawer-section { padding-top: 10rpx; }
.drawer-section-title { padding: 18rpx 0 14rpx; color: #a79d8e; font-size: 21rpx; }
.drawer-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 28rpx 18rpx; }
.drawer-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.drawer-item image { display: block; width: 44rpx; height: 44rpx; }
.drawer-item label { color: #4d4a44; font-size: 20rpx; line-height: 1.2; text-align: center; }
@keyframes drawer-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
/* 从“我的资产”导入题目：底部抽屉里的第二层列表 */
.import-layer { position: fixed; z-index: 72; top: 0; right: 0; bottom: 0; left: 0; }
.import-mask { position: absolute; inset: 0; background: rgba(24,35,29,.34); }
.import-sheet { position: absolute; right: 0; bottom: 0; left: 0; max-height: 72vh; padding: 24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); background: #fbfbfa; border-radius: 24rpx 24rpx 0 0; animation: drawer-up .24s ease-out; box-sizing: border-box; }
.import-head { display: flex; padding-bottom: 18rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e8ebe8; }
.import-head text { color: #222a25; font-size: 27rpx; font-weight: 800; }
.import-close { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; color: #6b746e; font-size: 34rpx; line-height: 1; }
.import-scroll { max-height: calc(72vh - 130rpx - env(safe-area-inset-bottom)); }
.import-row { display: flex; padding: 20rpx 4rpx; align-items: center; border-bottom: 1rpx solid #eef1ee; gap: 16rpx; }
.import-mark { display: flex; width: 48rpx; height: 48rpx; flex: 0 0 48rpx; align-items: center; justify-content: center; color: #2b7188; background: #e1f1f5; border-radius: 50%; font-size: 18rpx; font-weight: 800; }
.import-copy { min-width: 0; flex: 1; }
.import-copy text { display: block; overflow: hidden; color: #303530; font-size: 22rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.import-copy label { display: block; margin-top: 5rpx; overflow: hidden; color: #8a918c; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.import-add { display: flex; width: 44rpx; height: 44rpx; flex: 0 0 44rpx; align-items: center; justify-content: center; color: #fff; background: #343834; border-radius: 50%; font-size: 27rpx; font-weight: 300; }
.import-empty { padding: 80rpx 24rpx; color: #8a918c; font-size: 21rpx; line-height: 1.6; text-align: center; }
.section-lead { height: 30rpx; }
.drag-ghost-count { position: absolute; top: -14rpx; right: -14rpx; display: flex; min-width: 46rpx; height: 46rpx; padding: 0 8rpx; align-items: center; justify-content: center; color: #fff; background: #2f9fff; border-radius: 23rpx; box-shadow: 0 6rpx 16rpx rgba(47,159,255,.35); font-size: 22rpx; font-weight: 800; box-sizing: border-box; }

/* 样式设置：本題包卡片颜色面板（与卡集列表页「选择卡盒颜色」同一套视觉） */
.color-layer { position: fixed; z-index: 74; top: 0; right: 0; bottom: 0; left: 0; }
.color-mask { position: absolute; inset: 0; background: rgba(24,35,29,.34); }
.color-panel { position: absolute; right: 0; bottom: 0; left: 0; max-height: 82vh; overflow-y: auto; padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; animation: drawer-up .24s ease-out; box-sizing: border-box; }
.color-modes { display: grid; padding: 6rpx 0 8rpx; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx; }
.color-mode { display: flex; height: 132rpx; padding: 0 24rpx; align-items: center; justify-content: center; color: #4d4a44; background: #f5f3ef; border: 2rpx solid transparent; border-radius: 20rpx; gap: 14rpx; box-sizing: border-box; }
.color-mode image { display: block; width: 44rpx; height: 44rpx; }
.color-mode label { font-size: 23rpx; font-weight: 650; }
.color-mode-active { color: #1c1a17; background: #fdf3e3; border-color: #e8cfa4; }
.color-sheet-grid { display: grid; padding: 22rpx 0 6rpx; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 22rpx; }
.color-swatch { height: 132rpx; background: #f4f6f4; border: 4rpx solid transparent; border-radius: 20rpx; box-sizing: border-box; }
.color-swatch-active { position: relative; border-color: #4a74a6; }
.color-swatch-active::after { position: absolute; right: 14rpx; bottom: 12rpx; color: #4a74a6; font-size: 26rpx; content: "✓"; }
.color-note { padding: 16rpx 0 4rpx; color: #a79d8e; font-size: 20rpx; line-height: 1.5; }
.color-apply { display: flex; height: 92rpx; margin-top: 24rpx; align-items: center; justify-content: center; color: #fff; background: #2d322f; border-radius: 20rpx; font-size: 26rpx; font-weight: 700; }
.color-apply:active { background: #1f231f; }
.collection-state { display: flex; min-height: 100vh; padding: 0 40rpx; align-items: center; justify-content: center; flex-direction: column; color: #68756d; font-size: 22rpx; text-align: center; box-sizing: border-box; }
.collection-error button { width: 220rpx; height: 72rpx; margin-top: 22rpx; color: #fff; background: #26322b; border-radius: 6rpx; font-size: 20rpx; line-height: 72rpx; }
.collection-error button::after { display: none; }

/* 目录抽屉：与知识卡卡集页 / 刷题页同一套左侧抽屉（固定高度、不随目录条数变化） */
.catalog-layer { position: fixed; z-index: 1500; top: 0; right: 0; bottom: 0; left: 0; }
.catalog-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(20,20,20,.34); }
.catalog-panel { position: absolute; bottom: 32rpx; left: 28rpx; display: flex; width: 78%; max-width: 610rpx; max-height: 72vh; overflow: hidden; flex-direction: column; background: #fff; border: 1rpx solid #e8e8e5; border-radius: 16rpx; box-sizing: border-box; }
.catalog-head { display: flex; min-height: 88rpx; padding: 20rpx 24rpx; align-items: center; flex: 0 0 auto; border-bottom: 1rpx solid #e8e8e5; box-sizing: border-box; }
.catalog-title { color: #1d1d1d; font-size: 30rpx; font-weight: 850; }
.catalog-status { margin-right: 16rpx; margin-left: auto; color: #8d9691; font-size: 19rpx; font-weight: 500; }
.catalog-collapse-button { display: flex; width: 58rpx; height: 58rpx; flex: 0 0 58rpx; align-items: center; justify-content: center; border-radius: 8rpx; }
.catalog-collapse-button image { display: block; width: 36rpx; height: 36rpx; }
.catalog-pressed { background: #eeeeec; }
.catalog-back { display: flex; width: 58rpx; height: 58rpx; margin-left: -12rpx; flex: 0 0 58rpx; align-items: center; justify-content: center; border-radius: 8rpx; }
.catalog-back image { display: block; width: 34rpx; height: 34rpx; }
.catalog-summary-title { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.catalog-scroll { min-height: 0; height: 0; flex: 1; }
.catalog-empty { display: flex; min-height: 300rpx; padding: 72rpx 40rpx; flex-direction: column; align-items: center; color: #8a8e8a; text-align: center; }
.catalog-empty-title { color: #303330; font-size: 28rpx; font-weight: 700; }
.catalog-empty-detail { margin-top: 12rpx; font-size: 21rpx; line-height: 1.5; }
.catalog-row { display: flex; min-height: 84rpx; padding: 14rpx 24rpx; align-items: center; color: #303030; font-size: 26rpx; font-weight: 750; box-sizing: border-box; }
.catalog-row:active { background: #f4f4f2; }
.catalog-node { width: 38rpx; flex: 0 0 38rpx; color: #aeb4b1; font-size: 25rpx; }
.catalog-row-title { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.catalog-row-count { margin-left: 12rpx; flex: 0 0 auto; color: #999e9a; font-size: 19rpx; font-weight: 500; }
.catalog-row-count-active { padding: 4rpx 10rpx; color: #2f7d5c; background: #eaf4ef; border-radius: 999rpx; }
.catalog-depth-0 { padding-left: 24rpx; }
.catalog-depth-1 { padding-left: 56rpx; color: #3d453f; font-size: 24rpx; font-weight: 700; }
.catalog-depth-2 { padding-left: 88rpx; color: #59615b; font-size: 22rpx; font-weight: 650; }
.catalog-summary { padding-bottom: 20rpx; }
.catalog-summary-item { display: grid; min-height: 106rpx; margin: 0 18rpx; padding: 20rpx 10rpx; align-items: start; border-bottom: 1rpx solid #ecece9; grid-template-columns: 52rpx minmax(0,1fr); box-sizing: border-box; }
.catalog-summary-item:active { background: #f1f3f1; }
.catalog-summary-number { padding-top: 2rpx; color: #9a9f9c; font-size: 20rpx; font-variant-numeric: tabular-nums; }
.catalog-summary-stem { color: #303330; font-size: 23rpx; line-height: 1.55; }
.catalog-summary-stem-muted { color: #9aa39d; }
