<!-- 注册引导层。2026-10-17 改版（产品负责人指定）：参照得物登录页的干净风格——
     整页白底、去掉深色遮罩与底部上滑手柄；居中品牌方块 → 一枚主按钮 → 一枚文字副入口（先跳过看看）
     → 页面最底部一行协议勾选。整页无返回，出口只有"登录完成"或"先跳过看看"。 -->
<view class="onboarding-page {{stage === 'login' ? 'onboarding-page-login' : 'onboarding-page-form'}}" style="padding-top: {{statusBarHeight}}px;">
  <block wx:if="{{stage === 'login'}}">
    <view class="login-hero">
      <!-- 品牌位＝产品负责人给的商标原图：浅灰圆底 + 白描边 + 投影 + 黄果身土豆，保留原样（不抠底、不加罩）。
           素材是 assets/logo-potato.jpg（600×600，由 tmp/make-logo-mark.js 从 1280 原图生成，
           只把右下角「豆包AI生成」水印刷白）；用 JPG 是因为这张图带光影渐变，
           PNG 会突破仓库「单图 ≤ 200KB」的约束。 -->
      <image class="brand-badge" src="/assets/logo-potato.jpg" mode="aspectFit" aria-label="薯考商标" />
      <view class="brand-sub">汉语言文学题库 · 刷题与复习</view>
    </view>

    <view class="login-actions">
      <view class="primary-button {{(loggingIn || !agreed) ? 'primary-button-busy' : ''}}" bindtap="login" role="button" aria-label="微信一键登录">{{loggingIn ? '登录中…' : '微信一键登录'}}</view>
      <!-- 原来图 1 的「先随便看看」换成得物「手机号登录」那个位置：一枚纯文字副入口，不写任何数据。 -->
      <view class="skip-entry" bindtap="skip" role="button" aria-label="先跳过看看">先跳过看看</view>
      <view class="hint" wx:if="{{hint}}">{{hint}}</view>
    </view>

    <!-- 协议行放在页面最底部（得物同款位置），三个入口都可点：
         微信侧的《用户隐私保护指引》（DEC-110 ③）+ 我们自己的《用户协议》《隐私政策》。
         登录即收集 openid 与后续四项属性，所以未勾选时主按钮置灰。 -->
    <view class="consent-row">
      <view class="consent-box {{agreed ? 'consent-box-on' : ''}}" bindtap="toggleAgree" role="checkbox" aria-checked="{{agreed}}" aria-label="同意用户隐私保护指引">{{agreed ? '✓' : ''}}</view>
      <view class="consent-copy" bindtap="toggleAgree">
        <text>已阅读并同意</text><text class="consent-link" catchtap="openPrivacyContract">《用户隐私保护指引》</text><text class="consent-link" data-doc="terms" catchtap="openDoc">《用户协议》</text><text class="consent-link" data-doc="privacy" catchtap="openDoc">《隐私政策》</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="sheet">
      <!-- 2026-10-17 三次调整（产品负责人："三个页面的布局与我给你参考图不一样"）：
           按参考图去掉顶部品牌行与进度圆点，只留左「‹」返回；
           标题与说明居中、选项居中。主按钮紧跟内容、不再贴页面底部（同日第二处调整）。
           同日第五处调整：右上角「跳过」会被微信胶囊遮住，挪到「下一步」按钮下面。 -->
      <view class="step-header" style="height: {{navBarHeight}}px;">
        <!-- 2026-10-17 第二十次调整：`‹` 字符在不同字体里高低不一（产品负责人：「上一步按钮好像低了」），
             改成 CSS 画的箭头，视觉中心由盒子决定，不受字形基线影响。
             第二十一次调整：「返回图标和下方文案左对齐」——容器改为左对齐，箭头贴在内容左边界上。
             进度条已按产品负责人「去掉进度条」整段移除（同日第二十一次）。 -->
        <view class="step-back {{step <= 1 ? 'step-back-hidden' : ''}}" bindtap="prevStep" role="button" aria-label="上一步"><view class="step-back-arrow"></view></view>
      </view>

      <view class="step-body">
        <!-- 2026-10-17 产品负责人：一屏四问拆成三步（每屏只问一件事），去掉"头像与昵称（选填）"折叠块，
             头像/昵称直接放在第 1 步。四项必填口径不变，仍是 DEC-109 的就地采集。 -->
        <block wx:if="{{step === 1}}">
          <!-- 2026-10-17 三次调整（产品负责人对着参考图指出三处）：①头像改成"一个圆、中间写着上传头像"；
               ②性别改成带图标的有色胶囊；③主按钮不再贴页面底部，紧跟内容。
               同日第七处调整：按他新给的参考图，头像上面加一段三行欢迎语；
               头像圆里默认铺土豆商标，并在圆底部压一条半透明条写「上传头像」。 -->
          <view class="intro">
            <view class="intro-hey">Hey~</view>
            <view class="intro-title">欢迎来到薯考</view>
            <view class="intro-note">完善你的资料，让别人更容易找到你</view>
          </view>

          <view class="avatar-upload-row">
            <button class="avatar-upload" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="上传头像">
              <image wx:if="{{avatarUrl}}" class="avatar-upload-img" src="{{avatarUrl}}" mode="aspectFill" />
              <block wx:else>
                <image class="avatar-upload-img" src="/assets/potato-avatar.png" mode="aspectFill" aria-label="薯考商标" />
                <view class="avatar-upload-mask"></view>
                <view class="avatar-upload-text">上传头像</view>
              </block>
            </button>
          </view>

          <input
            class="optional-input"
            type="nickname"
            value="{{nickname}}"
            maxlength="32"
            confirm-type="next"
            placeholder="昵称，不填就叫「薯考同学」"
            bindinput="inputNickname"
            bindblur="inputNickname"
            bindconfirm="inputNickname"
          />

          <!-- 性别：两颗并排胶囊、各带性别符号、选中时上色（男蓝女粉）；文案取自 genderOptions，不另写死。
               2026-10-17 产品负责人："去掉这个不愿透露" —— 页面只留男/女两档；
               GENDER_OPTIONS 里的 undisclosed 仍保留（服务端 GENDER_CHOICES 同款），只为兼容
               历史上已选该档的账号能正常读回，不再作为可选项展示。 -->
          <view class="gender-row">
            <block wx:for="{{genderOptions}}" wx:key="id">
              <view
                wx:if="{{item.id !== 'undisclosed'}}"
                class="gender-chip gender-{{item.id}} {{gender === item.id ? 'gender-chip-on' : ''}}"
                data-field="gender"
                data-id="{{item.id}}"
                bindtap="selectOption"
                role="button"
                aria-label="{{item.label}}"
              >
                <text class="gender-icon">{{item.id === 'male' ? '♂' : '♀'}}</text><text class="gender-text">{{item.label}}</text>
              </view>
            </block>
          </view>
          <!-- 2026-10-17 产品负责人（照参考图 1）：性别胶囊下方补一行说明，颜色与「跳过」一致。 -->
          <view class="gender-note">* 注册成功后性别不可随意修改哦</view>
        </block>

        <block wx:elif="{{step === 2}}">
          <!-- 2026-10-17 第九次调整（产品负责人：文案和图标布局也要模仿图 1）：
               左对齐大标题「遇见同龄人 🎉」+ 紧跟的副标题「你的生日是哪一天？」+ 三列滚轮 + 居中的保密小字。
               生日直接提交给服务端保存（`birthday` 字段），不再换算年龄段。 -->
          <view class="birthday-head">
            <view class="birthday-title">遇见同龄人<text class="birthday-emoji">🎉</text></view>
            <view class="birthday-subtitle">你的生日是哪一天？</view>
          </view>
          <picker-view
            class="birthday-wheel"
            value="{{birthdayIndexes}}"
            bindchange="onBirthdayChange"
            indicator-style="height: 120rpx; border-top: 1rpx solid #eceeed; border-bottom: 1rpx solid #eceeed;"
          >
            <picker-view-column>
              <view wx:for="{{birthYears}}" wx:key="*this" class="wheel-item">{{item}}年</view>
            </picker-view-column>
            <picker-view-column>
              <view wx:for="{{birthMonths}}" wx:key="*this" class="wheel-item">{{item}}月</view>
            </picker-view-column>
            <picker-view-column>
              <view wx:for="{{birthDays}}" wx:key="*this" class="wheel-item">{{item}}日</view>
            </picker-view-column>
          </picker-view>
          <view class="birthday-privacy">生日信息和年龄会为你保密，他人不可见</view>
        </block>

        <block wx:else>
          <view class="sheet-title">你考什么、哪一年考</view>
          <view class="sheet-note">用来圈定题库范围和备考节奏；之后可以在设置里查看。</view>

          <view class="field-group">
            <view class="field-label">目标考试项目</view>
            <view class="chip-row">
              <!-- 2026-10-17 产品负责人：去掉项目名下方「广东 · 普通专升本」那行副标题；
                   胶囊与其它档位同一套样式（宽度随内容、文字居中），不再整行拉满、不再文字靠左。 -->
              <view
                wx:for="{{projectOptions}}"
                wx:key="id"
                class="chip {{examProjectId === item.id ? 'chip-active' : ''}}"
                data-field="examProjectId"
                data-id="{{item.id}}"
                bindtap="selectOption"
                role="button"
                aria-label="{{item.label}}"
              >{{item.label}}</view>
            </view>
            <view class="field-error" wx:if="{{projectError}}" bindtap="loadProjects" role="button" aria-label="重新加载考试项目">{{projectError}}</view>
          </view>

          <view class="field-group">
            <view class="field-label">报考年份</view>
            <view class="chip-row">
              <view
                wx:for="{{yearOptions}}"
                wx:key="id"
                class="chip {{examYear === item.id ? 'chip-active' : ''}}"
                data-field="examYear"
                data-id="{{item.id}}"
                bindtap="selectOption"
                role="button"
                aria-label="{{item.label}}"
              >{{item.label}}</view>
            </view>
          </view>
        </block>
      </view>

      <view class="step-footer">
        <view class="hint" wx:if="{{hint}}">{{hint}}</view>
        <!-- 2026-10-17 第二十二次调整（产品负责人）：主按钮本身就是进度条——
             左侧按「当前步 / 总步数」填主题深绿，其余填浅绿：第 1 步 1/3、第 2 步 2/3、「开始使用」整条深绿。
             比例通过 CSS 变量 `--step-progress` 传给 wxss，忙碌态（busy）仍能正常覆盖背景。 -->
        <view class="primary-button {{submitting ? 'primary-button-busy' : ''}}" style="--step-progress: {{(step / stepTotal) * 100}}%;" bindtap="nextStep" role="button" aria-label="{{step >= stepTotal ? '开始使用' : '下一步'}}">{{step >= stepTotal ? (submitting ? '保存中…' : '开始使用') : '下一步'}}</view>
        <!-- 2026-10-17 产品负责人：「跳过」放「下一步」下面（原来在右上角，会被微信胶囊挡住）。 -->
        <view class="step-skip" bindtap="skip" role="button" aria-label="先跳过看看">跳过</view>
      </view>
    </view>
  </block>
</view>
