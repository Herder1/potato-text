.contribute-page { padding-bottom: 52rpx; }
.page-title { font-size: 42rpx; font-weight: 900; }
.page-subtitle { margin-top: 6rpx; color: #707974; font-size: 22rpx; }
.pack-context { display: flex; min-height: 82rpx; margin-top: 24rpx; padding: 0 20rpx; align-items: center; justify-content: space-between; background: #dff3f7; border-radius: 7rpx; box-sizing: border-box; }
.pack-context text { color: #5e767d; font-size: 20rpx; }
.pack-context view { max-width: 430rpx; overflow: hidden; color: #176d87; font-size: 23rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.method-row { display: grid; height: 84rpx; margin-top: 26rpx; padding: 6rpx; grid-template-columns: 1fr 1fr; background: #e9ebe8; border-radius: 8rpx; box-sizing: border-box; }
.method { display: flex; align-items: center; justify-content: center; color: #758079; border-radius: 6rpx; font-size: 24rpx; }
.method-active { color: #222522; background: #fff; font-weight: 800; }
.ocr-panel { margin-top: 18rpx; padding: 22rpx; background: #fff; border-radius: 8rpx; }
.preview,.upload-placeholder { width: 100%; height: 250rpx; margin-bottom: 16rpx; border-radius: 7rpx; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #eef0ed; border: 2rpx dashed #b8c1bb; box-sizing: border-box; }
.upload-title { font-size: 27rpx; font-weight: 800; }
.upload-desc,.ocr-status,.privacy-note { margin-top: 8rpx; color: #7a837e; font-size: 20rpx; }
.ocr-status { color: #267158; text-align: center; }
.form-section { margin-top: 30rpx; }
.section-title { color: #222522; font-size: 29rpx; font-weight: 900; }
.section-note { margin-top: 4rpx; color: #8b918d; font-size: 19rpx; }
.directory-panel { margin-top: 13rpx; overflow: hidden; background: #fff; border-radius: 8rpx; }
.directory-row { display: grid; min-height: 92rpx; padding: 17rpx 21rpx; align-items: center; border-bottom: 1rpx solid #e8ebe8; grid-template-columns: 120rpx minmax(0,1fr); box-sizing: border-box; }
.directory-row > text { color: #747d77; font-size: 21rpx; }
.directory-row > view { overflow: hidden; color: #303530; font-size: 23rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.directory-row > view text { margin-left: 8rpx; color: #9aa09b; font-size: 28rpx; }
.tag-area { margin-top: 18rpx; }
.tag-label { color: #69716c; font-size: 20rpx; }
.tag-list { display: flex; margin-top: 10rpx; flex-wrap: wrap; gap: 9rpx; }
.catalog-tag,.custom-tag { padding: 10rpx 13rpx; color: #5f6862; background: #e9ece9; border: 1rpx solid transparent; border-radius: 5rpx; font-size: 19rpx; }
.catalog-tag.tag-selected { color: #176d8c; background: #e0f3f9; border-color: #92cadc; }
.custom-tag { color: #6e567f; background: #eee8f3; }
.custom-tag-row { display: grid; height: 72rpx; margin-top: 15rpx; grid-template-columns: minmax(0,1fr) 104rpx; gap: 9rpx; }
.custom-tag-row input { height: 100%; padding: 0 17rpx; background: #fff; border-radius: 7rpx; font-size: 21rpx; }
.custom-tag-row button { height: 72rpx; margin: 0; padding: 0; color: #fff; background: #555b57; border-radius: 7rpx; font-size: 20rpx; line-height: 72rpx; }
.input-block { padding: 19rpx 21rpx; border-bottom: 1rpx solid #e8ebe8; }
.input-block > text { color: #737c76; font-size: 21rpx; }
.input-block textarea { width: 100%; min-height: 190rpx; margin-top: 10rpx; color: #303530; font-size: 24rpx; line-height: 1.65; }
.input-block .short-textarea { min-height: 118rpx; }
.choice-grid { display: grid; margin-top: 14rpx; grid-template-columns: repeat(3,1fr); gap: 9rpx; }
.choice-item { min-height: 104rpx; padding: 16rpx 12rpx; background: #e9ebe8; border: 2rpx solid transparent; border-radius: 7rpx; box-sizing: border-box; }
.choice-item text { color: #333834; font-size: 22rpx; font-weight: 800; }
.choice-item view { margin-top: 5rpx; color: #858c87; font-size: 17rpx; line-height: 1.4; }
.choice-item.choice-active { background: #fff; border-color: #4e8ea5; }
.source-input { height: 76rpx; margin-top: 12rpx; padding: 0 18rpx; background: #fff; border-radius: 7rpx; }
.source-input input { height: 100%; font-size: 21rpx; }
.declaration { display: flex; min-height: 76rpx; margin-top: 10rpx; align-items: center; color: #59615c; font-size: 20rpx; }
.declaration checkbox { margin-right: 10rpx; transform: scale(.82); }
.visibility-grid { display: grid; margin-top: 8rpx; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.visibility-item { min-height: 108rpx; padding: 17rpx; background: #e9ebe8; border: 2rpx solid transparent; border-radius: 7rpx; box-sizing: border-box; }
.visibility-item text { color: #303530; font-size: 22rpx; font-weight: 850; }
.visibility-item view { margin-top: 6rpx; color: #858c87; font-size: 18rpx; }
.visibility-item.visibility-active { background: #fff; border-color: #4e8ea5; }
.save-button { margin-top: 28rpx; border-radius: 8rpx; }
.privacy-note { margin: 13rpx 8rpx 0; line-height: 1.6; text-align: center; }
