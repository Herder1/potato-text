<view class="page-shell contributions-page">
  <!-- 卡片 1（2026-10-02 按产品负责人参考图重做）：白卡 + 圆角 + 青绿进度条。
       左「当前头衔」/ 右「下一等级 · 薯露头角」，下面是大字号头衔名；
       下一行左「还需 N 分」、右「经验值 N」，再下面是进度条。
       进度对外显示的是**经验值分值**（不是百分比，也不拆成"公开数/收藏数"两栏）——
       帖子和公开的收藏/点赞权重后续还会调整，按维度展示会失真。
       经验值 = 内容分 + 认可分，权重集中在 utils/community-profile.js 的 experienceRules，本页不写死任何权重。
       整块可点，打开升级门槛详情弹层。 -->
  <view class="tier-card" bindtap="openTierSheet" role="button" aria-label="查看升级门槛详情">
    <view class="tier-card-top">
      <text class="tier-card-label">当前头衔</text>
      <text class="tier-card-next" wx:if="{{identity.next}}">下一等级 · {{identity.next.label}}</text>
      <text class="tier-card-next" wx:else>已是最高等级</text>
    </view>
    <view class="tier-card-name">{{identity.current.label}}</view>
    <view class="tier-progress-head">
      <text class="tier-progress-hint">{{identity.progressText}}</text>
      <text class="tier-progress-score">经验值 {{identity.score}}</text>
    </view>
    <view class="tier-progress-track"><view class="tier-progress-value" style="width: {{identity.progress}}%;"></view></view>
  </view>

  <!-- 卡片 2：公开 / 帖子 两类切换 + 内容卡片列表（一张卡片一项：标题 + 右侧「科目 · 类型」+ 概述 + 状态与计数）。
       卡片底部只显示**真实存在**的数据：收藏数与被导入数。点赞与评论目前没有数据源
       （见 OPEN_DECISIONS §1.24），一律不渲染，不塞假数字。 -->
  <view class="feed-card">
    <view class="mode-tabs">
      <view class="mode-tab {{activeMode === 'published' ? 'mode-tab-active' : ''}}" data-id="published" bindtap="selectMode">公开</view>
      <view class="mode-tab {{activeMode === 'posts' ? 'mode-tab-active' : ''}}" data-id="posts" bindtap="selectMode">帖子</view>
    </view>

    <block wx:if="{{activeMode === 'published'}}">
      <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="filter-row">
          <view wx:for="{{filters}}" wx:key="id" class="filter {{activeFilter === item.id ? 'filter-active' : ''}}" data-id="{{item.id}}" bindtap="selectFilter">{{item.label}}</view>
        </view>
      </scroll-view>

      <view class="sync-note" wx:if="{{syncing}}">正在同步最新状态</view>
      <view class="feed-list" wx:if="{{visibleItems.length}}">
        <view class="feed-item" wx:for="{{visibleItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openContribution">
          <view class="feed-item-head">
            <view class="feed-item-title">{{item.title}}</view>
            <view class="feed-item-tag">{{item.subjectName ? item.subjectName + ' · ' : ''}}{{item.typeLabel}}</view>
          </view>
          <view class="feed-item-excerpt">{{item.excerpt || item.pathText}}</view>
          <view class="feed-item-foot">
            <text class="status status-{{item.moderationStatus}}">{{item.statusLabel}}</text>
            <text wx:if="{{item.moderationStatus === 'published'}}">收藏 {{item.favoriteCount}}</text>
            <text wx:if="{{item.moderationStatus === 'published'}}">导入 {{item.copyCount}}</text>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:else>
        <view>{{activeFilter === 'all' ? '还没有公开投稿记录' : '当前分类没有内容'}}</view>
        <text wx:if="{{activeFilter === 'all'}}">公开自己的题目、笔记或卡片后，会在这里显示进度</text>
        <button wx:if="{{activeFilter === 'all'}}" bindtap="openAssets">管理我的资产</button>
      </view>
    </block>

    <view class="empty-state" wx:else>
      <view>帖子还没有开放</view>
      <text>社区帖子上线后，你发布的交流内容会显示在这里</text>
    </view>
  </view>

  <!-- 升级门槛详情：底部弹层（产品负责人 2026-10-02 选定） -->
  <view class="sheet-mask" wx:if="{{tierSheetVisible}}" bindtap="closeTierSheet"></view>
  <view class="tier-sheet" wx:if="{{tierSheetVisible}}">
    <view class="sheet-head"><text>升级门槛</text><label>按经验值自动更新</label></view>
    <view class="level-list">
      <view class="level-row {{item.current ? 'level-current' : ''}}" wx:for="{{identity.levels}}" wx:key="id">
        <view class="level-state {{item.achieved ? 'level-state-achieved' : ''}}">{{item.achieved ? '✓' : ''}}</view>
        <view class="level-main"><text>{{item.label}}</text><label>{{item.requirement}}</label></view>
        <view class="current-label" wx:if="{{item.current}}">当前</view>
      </view>
    </view>
    <view class="sheet-note">经验值 = 公开内容分 + 认可分。公开内容逐篇递减：前 10 篇 ×3、第 11–30 篇 ×1、第 31 篇以上 ×0.1。认可分按单篇算并封顶：单篇收藏前 10 次 ×8、第 11–50 次 ×4、第 51 次以上 ×1，单篇最多 500 分。收藏/点赞取消不回退，同一人对同一篇只计一次。</view>
    <button class="sheet-close" bindtap="closeTierSheet">知道了</button>
  </view>
</view>
