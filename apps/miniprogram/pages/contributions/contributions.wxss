.contributions-page { padding-top: 32rpx; }
.page-head { display: flex; align-items: center; justify-content: space-between; }
.page-title { color: #222622; font-size: 42rpx; font-weight: 900; }
.page-subtitle { margin-top: 5rpx; color: #7f8782; font-size: 21rpx; }
.identity-entry { display: flex; min-height: 62rpx; padding: 0 18rpx; align-items: center; justify-content: center; color: #45524b; background: #e8ebe8; border-radius: 6rpx; font-size: 20rpx; }
.contribution-summary { display: grid; min-height: 126rpx; margin-top: 26rpx; padding: 14rpx 0; background: #303633; border-radius: 8rpx; grid-template-columns: repeat(4,1fr); box-sizing: border-box; }
.contribution-summary > view { display: flex; align-items: center; justify-content: center; flex-direction: column; border-right: 1rpx solid rgba(255,255,255,.13); }
.contribution-summary > view:last-child { border-right: 0; }
.contribution-summary text,.contribution-summary label { display: block; }
.contribution-summary text { color: #fff; font-size: 32rpx; font-weight: 900; }
.contribution-summary label { margin-top: 5rpx; color: rgba(255,255,255,.65); font-size: 18rpx; }
.filter-scroll { margin-top: 22rpx; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 10rpx; }
.filter { display: flex; min-width: 118rpx; height: 62rpx; padding: 0 19rpx; align-items: center; justify-content: center; color: #69726c; background: #e7eae7; border-radius: 31rpx; font-size: 20rpx; box-sizing: border-box; }
.filter-active { color: #fff; background: #3b403c; font-weight: 800; }
.sync-note { padding: 20rpx 0 2rpx; color: #8a918c; font-size: 18rpx; text-align: center; }
.contribution-list { margin-top: 18rpx; overflow: hidden; background: #fff; border: 1rpx solid #e5e9e5; border-radius: 8rpx; }
.contribution-row { display: grid; min-height: 138rpx; padding: 21rpx; align-items: center; border-bottom: 1rpx solid #e8ebe8; grid-template-columns: 58rpx minmax(0,1fr) 28rpx; gap: 15rpx; box-sizing: border-box; }
.contribution-row:last-child { border-bottom: 0; }
.type-mark { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; color: #2e7188; background: #e1f0f5; border-radius: 50%; font-size: 19rpx; font-weight: 850; }
.type-note { color: #337052; background: #e5f1e8; }
.type-question_pack,.type-card_pack { color: #80611e; background: #f5edcf; }
.contribution-main { min-width: 0; }
.contribution-title { overflow: hidden; color: #2d332f; font-size: 24rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.contribution-path { margin-top: 6rpx; overflow: hidden; color: #858c87; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.contribution-meta { display: flex; margin-top: 9rpx; align-items: center; color: #939a95; font-size: 17rpx; gap: 11rpx; }
.status { padding: 4rpx 7rpx; border-radius: 3rpx; }
.status-published { color: #28704b; background: #e2f2e7; }
.status-pending_review { color: #8b610b; background: #faefcc; }
.status-rejected,.status-offline { color: #9b4942; background: #f5e5e3; }
.row-arrow { color: #a2a8a3; font-size: 30rpx; }
.empty-state { margin-top: 18rpx; padding: 86rpx 24rpx; color: #303631; background: #fff; border: 1rpx solid #e7eae7; border-radius: 8rpx; text-align: center; }
.empty-state view { font-size: 25rpx; font-weight: 850; }
.empty-state text { display: block; margin: 9rpx auto 0; max-width: 520rpx; color: #8b928d; font-size: 19rpx; line-height: 1.6; }
.empty-state button { width: 240rpx; height: 68rpx; margin: 25rpx auto 0; padding: 0; color: #fff; background: #373c38; border-radius: 6rpx; font-size: 21rpx; line-height: 68rpx; }
