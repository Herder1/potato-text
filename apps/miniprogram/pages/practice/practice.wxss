}

.catalog-sync-status.synced { color: #2e745b; }
.catalog-sync-status.exam { color: #526173; }
.catalog-sync-status.offline { color: #a26435; }

.catalog-chapter {
  display: flex;
  min-height: 88rpx;
  padding: 14rpx 24rpx;
  align-items: center;
  color: #303030;
  font-size: 27rpx;
  font-weight: 750;
