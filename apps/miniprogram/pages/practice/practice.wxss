  height: 56vh;
  max-height: calc(100vh - 120rpx);
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  flex-direction: column;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.utility-dialog-tall {
  height: 70vh;
}

.utility-dialog-head {
  display: flex;
  min-height: 94rpx;
  padding: 0 20rpx;
  flex: 0 0 94rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  border-bottom: 1rpx solid #e9e9e6;
  box-sizing: border-box;
}

.utility-dialog-back {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.utility-dialog-back image {
