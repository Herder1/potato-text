}

.catalog-question-count {
  margin-left: 12rpx;
  flex: 0 0 auto;
  color: #999e9a;
  font-size: 19rpx;
  font-weight: 500;
}

/* 综合训练里科目行左侧的"待归组"提示：与正式投影题数分开命名、分开计数（不是正式题数的一部分），
   用更弱的字重和颜色，避免被读成"这一科有这么多题"。 */
.catalog-pending {
  margin-left: 12rpx;
  flex: 0 0 auto;
  color: #b3925f;
  font-size: 19rpx;
  font-weight: 500;
}

.catalog-sections {
  margin-left: 42rpx;
  padding-left: 18rpx;
  border-left: 2rpx solid #ecece9;
}

.catalog-section {
  display: flex;
  min-height: 76rpx;
  padding: 10rpx 18rpx 10rpx 8rpx;
  align-items: center;
  color: #686f6b;
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.catalog-section text {
  width: 8rpx;
  height: 8rpx;
  margin-right: 18rpx;
  flex: 0 0 8rpx;
  background: #c7ccca;
  border-radius: 50%;
}

.catalog-level-3 {
  padding-left: 34rpx;
  font-size: 22rpx;
}

/* 综合训练的目录是「科目 → 章/编/单元 → 节 → 小点」：三级往下要继续缩进，否则浅层和深层看起来一样平。 */
.catalog-level-4 {
  padding-left: 58rpx;
  font-size: 21rpx;
}

.catalog-level-5 {
  padding-left: 82rpx;
  font-size: 20rpx;
}

/* 科目行是综合训练目录的根：比册内章标题再重一点，和下面的章/编区分开。 */
.catalog-subject {
  color: #171717;
  font-weight: 800;
}

.catalog-subject .catalog-question-count {
  color: #2e745b;
  font-weight: 600;
}

.catalog-section-title {
  min-width: 0;
  flex: 1;
}

.catalog-section-count {
  margin-left: 12rpx;
  flex: 0 0 auto;
  color: #a5aaa7;
  font-size: 19rpx;
}

.catalog-unavailable {
  color: #a5aaa7;
}

.catalog-unavailable text {
  background: #dde0de;
}

.catalog-question-summary {
  padding-bottom: 20rpx;
}

.catalog-question-item {
  display: grid;
  min-height: 106rpx;
  margin: 0 18rpx;
  padding: 20rpx 10rpx;
  align-items: start;
  border-bottom: 1rpx solid #ecece9;
  grid-template-columns: 52rpx minmax(0, 1fr);
  box-sizing: border-box;
}

.catalog-question-current {
  background: #f1f3f1;
}

.catalog-question-number {
  padding-top: 2rpx;
  color: #9a9f9c;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.catalog-question-stem {
  color: #303330;
  font-size: 23rpx;
  line-height: 1.55;
}

.catalog-current {
  color: #171717;
  background: #f1f1ef;
}

.question-search-panel {
  position: absolute;
  right: 0;
  left: 0;
  padding: 24rpx 28rpx 26rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e5e5e2;
  box-sizing: border-box;
  overflow: hidden;
}

.question-search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.question-search-field {
  display: flex;
  min-width: 0;
  height: 76rpx;
  flex: 1;
  align-items: center;
  border: 2rpx solid #d6d6d2;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.question-search-field input {
  min-width: 0;
  height: 100%;
  padding: 0 10rpx 0 22rpx;
  flex: 1;
  color: #222222;
  font-size: 24rpx;
  box-sizing: border-box;
}

.question-search-clear {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  color: #858581;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.question-search-row button {
  width: 104rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 104rpx;
  color: #ffffff;
  background: #303030;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.question-search-row button::after {
  border: 0;
}

.search-result-summary {
  margin-top: 18rpx;
  color: #7b7b78;
  font-size: 21rpx;
}

.question-search-results {
  max-height: 440rpx;
}

.question-search-result {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  background: #f4f4f2;
  border-radius: 12rpx;
}

.search-result-title {
  display: -webkit-box;
  overflow: hidden;
  color: #242424;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.search-result-path,
.search-empty {
  margin-top: 8rpx;
  color: #858581;
  font-size: 20rpx;
}

.search-empty {
  margin-top: 0;
  padding: 30rpx 0 8rpx;
  text-align: center;
}

.share-dialog {
