}

.ai-modal-layer {
  z-index: 2100;
}

.ai-dialog {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  flex-direction: column;
  background: #fbfbfa;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
  transition: height 160ms ease;
}

.ai-dialog-dragging {
  transition: none;
}

.ai-resize-handle {
  display: flex;
  width: 100%;
  height: 34rpx;
  flex: 0 0 34rpx;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.ai-resize-handle view {
