.practice-page {
  position: relative;
  display: flex;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  flex-direction: column;
  background: #f7f7f5;
}

.practice-loading {
  display: flex;
  width: 100%;
  height: 100vh;
  align-items: center;
  justify-content: center;
  background: #f7f7f5;
}

.practice-loading-spinner {
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid #d9dfdb;
  border-top-color: #19b6e6;
  border-radius: 50%;
  animation: practice-loading-spin 700ms linear infinite;
  box-sizing: border-box;
}

@keyframes practice-loading-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.practice-page button::after {
  border: 0;
}

.custom-practice-nav {
  display: flex;
  width: 100%;
  padding-left: 14rpx;
  flex: 0 0 auto;
  align-items: flex-end;
  background: #fbfbfa;
  border-bottom: 1rpx solid #ebebe8;
  box-sizing: border-box;
}

.nav-icon-button {
  display: flex;
  width: 64rpx;
  height: 72rpx;
  margin: 0 2rpx;
  padding: 0;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  color: #444a46;
  background: transparent;
  border-radius: 8rpx;
  line-height: 1;
}

.nav-toolbar-spacer {
  min-width: 8rpx;
  flex: 1;
}

.pack-nav-title {
  min-width: 0;
  max-width: 280rpx;
  overflow: hidden;
  color: #303330;
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-icon-pressed,
.nav-icon-active {
  background: #eeeeec;
}

.nav-icon-image {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.practice-head {
  height: 96rpx;
  padding: 16rpx 28rpx 0;
  flex: 0 0 96rpx;
  background: #fbfbfa;
  border-bottom: 1rpx solid #ebebe8;
  box-sizing: border-box;
}

.head-row,
.question-meta,
.source-line,
.tool-panel-head,
.dialog-head,
.share-setting,
.ai-dialog-head-right,
.ai-composer {
  display: flex;
  align-items: center;
}

.head-row,
.tool-panel-head,
.dialog-head,
.share-setting {
  justify-content: space-between;
}

.breadcrumb,
.question-count {
  color: #627069;
  font-size: 23rpx;
}

.breadcrumb {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.question-count {
  flex: 0 0 auto;
}

.head-status {
  display: flex;
  margin-left: 20rpx;
  flex: 0 0 auto;
  align-items: center;
  gap: 16rpx;
}

.exam-timer {
  color: #9d443d;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 750;
}

.progress-track {
  height: 7rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: #e6e6e4;
  border-radius: 999rpx;
}

.progress-value {
  width: 10%;
  height: 100%;
  background: #19b6e6;
  border-radius: 999rpx;
}

.question-scroll {
  width: 100%;
  min-height: 0;
  height: 0;
  flex: 1;
}

.question-swipe-stage {
  min-height: 100%;
  will-change: transform, opacity;
}

.question-swipe-stage.question-swipe-animating {
  transition: transform 180ms cubic-bezier(0.22, 0.72, 0.3, 1), opacity 150ms ease;
}

.swipe-direction-hint {
  position: absolute;
  top: 45%;
  z-index: 7;
  display: flex;
  width: 48rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(27, 39, 34, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  font-size: 46rpx;
  line-height: 1;
  opacity: 0;
  pointer-events: none;
  transform: translateX(0) scale(0.88);
  transition: opacity 120ms ease, transform 160ms ease;
}

.swipe-direction-left {
  left: 0;
  border-radius: 0 999rpx 999rpx 0;
  transform: translateX(-14rpx) scale(0.88);
}

.swipe-direction-right {
  right: 0;
  border-radius: 999rpx 0 0 999rpx;
  transform: translateX(14rpx) scale(0.88);
}

.swipe-direction-visible {
  opacity: 1;
  transform: translateX(0) scale(1);
}

.question-body {
  padding: 30rpx 28rpx 60rpx;
}

.question-meta {
  display: flex;
  width: 100%;
  min-width: 0;
  gap: 14rpx;
  align-items: center;
  box-sizing: border-box;
}

.question-meta > .tag,
.question-meta > .score {
  flex: 0 0 auto;
}

.question-votes,
.question-vote-button {
  display: flex;
  align-items: center;
}

.question-topline {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
}

.question-votes {
  flex: 0 0 auto;
  justify-content: flex-end;
  gap: 6rpx;
}

.question-vote-button {
  width: 60rpx;
  min-width: 60rpx;
  height: 50rpx;
  margin: 0;
  padding: 0 4rpx;
  flex: 0 0 60rpx;
  justify-content: center;
  color: #8b8e8b;
  background: transparent;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1;
  box-sizing: border-box;
}

.question-vote-pressed {
  background: #eeeeec;
}

.vote-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
}

.vote-icon-down {
  transform: rotate(180deg);
}

.vote-cuff {
  position: absolute;
  bottom: 2rpx;
  left: 1rpx;
  width: 7rpx;
  height: 15rpx;
  border: 2rpx solid currentColor;
  border-radius: 2rpx;
  box-sizing: border-box;
}

.vote-palm {
  position: absolute;
  right: 1rpx;
  bottom: 2rpx;
  width: 21rpx;
  height: 17rpx;
  border: 2rpx solid currentColor;
  border-left: 0;
  border-radius: 0 5rpx 5rpx 0;
  box-sizing: border-box;
}

.vote-finger {
  position: absolute;
  top: 1rpx;
  left: 9rpx;
  width: 9rpx;
  height: 16rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  border-radius: 0 7rpx 0 0;
  transform: skew(-12deg);
  box-sizing: border-box;
}

.vote-count {
  min-width: 18rpx;
  margin-left: 6rpx;
  font-variant-numeric: tabular-nums;
}

.question-vote-active {
  color: #176b52;
  background: transparent;
}

.question-vote-active-negative {
  color: #9d443d;
  background: transparent;
}

.score {
  color: #6c7771;
  font-size: 22rpx;
}

.difficulty-stars {
  color: #a36a1e;
  font-size: 24rpx;
  line-height: 1;
}

.question-detail-line {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 48rpx;
  align-items: center;
  color: #6c7771;
  font-size: 21rpx;
  box-sizing: border-box;
}

.question-detail-line-pressed {
  color: #343936;
}

.knowledge {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.frequency-label {
  margin-left: 18rpx;
  flex: 0 0 auto;
  color: #397291;
}

.question-detail-chevron {
  margin-left: 8rpx;
  flex: 0 0 auto;
  color: #9a9f9b;
  font-size: 30rpx;
  line-height: 1;
}

.question-feedback-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 20rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid #e8e9e6;
  color: #6f746f;
  font-size: 20rpx;
}

.stem {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.options {
  margin-top: 30rpx;
}

.option {
  display: flex;
  min-height: 110rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  align-items: flex-start;
  background: #ffffff;
  border: 2rpx solid #e8e8e5;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.option-selected {
  border-color: #303030;
  background: #f3f3f1;
}

.option-correct {
  border-color: #2e7b5f;
  background: #e8f4ee;
}

.option-wrong {
  border-color: #bd4c43;
  background: #faecea;
}

.option-key {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  color: #405048;
  background: #edf0ed;
  border-radius: 50%;
  font-size: 25rpx;
  font-weight: 700;
}

.option-text {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
}

.answer-panel {
  margin: 34rpx -28rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-top: 1rpx solid #e9e9e6;
}

.answer-result {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.result-partial {
  color: #9a5b08;
  background: rgba(255, 237, 194, 0.72);
}

.question-material {
  margin: 22rpx 0 28rpx;
  padding: 24rpx 26rpx;
  color: #35403d;
  line-height: 1.78;
  white-space: pre-wrap;
  background: rgba(245, 247, 245, 0.86);
  border-left: 6rpx solid #9caaa5;
}

.question-material-label {
  margin-bottom: 10rpx;
  color: #78847f;
  font-size: 22rpx;
  font-weight: 600;
}

.question-material-text {
  white-space: pre-wrap;
}

.material-segment {
  white-space: pre-wrap;
}

.material-mark-underline {
  padding-bottom: 2rpx;
  border-bottom: 3rpx solid #26332d;
}

.material-mark-double_underline {
  padding-bottom: 2rpx;
  border-bottom: 7rpx double #26332d;
}

.material-mark-wave {
  text-decoration-color: #26332d;
  text-decoration-line: underline;
  text-decoration-style: wavy;
  text-decoration-thickness: 2rpx;
  text-underline-offset: 5rpx;
}

.material-mark-dot {
  -webkit-text-emphasis: filled dot #26332d;
  -webkit-text-emphasis-position: under;
  text-emphasis: filled dot #26332d;
  text-emphasis-position: under;
}

.result-correct {
  color: #176b52;
  background: #e8f4ee;
}

.result-wrong {
  color: #a43e36;
  background: #f8e9e7;
}

.answer-heading {
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.answer-text {
  margin-top: 12rpx;
  color: #39433e;
  line-height: 1.75;
}

.answer-rich-text {
  display: block;
  overflow-wrap: anywhere;
}

.answer-rich-text strong {
  color: #202d26;
  font-weight: 600;
}

.source-line {
  margin-top: 20rpx;
  align-items: flex-start;
  gap: 12rpx;
}

.source-text {
  min-width: 0;
  padding-top: 5rpx;
  flex: 1;
  color: #6d7872;
  font-size: 22rpx;
}

.scoring-basis-list {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e7e8e4;
}

.scoring-basis-title {
  color: #737973;
  font-size: 21rpx;
  font-weight: 700;
}

.scoring-basis-item {
  padding: 14rpx 0;
}

.scoring-basis-item + .scoring-basis-item {
  border-top: 1rpx solid #eeefec;
}

.scoring-basis-row {
  display: flex;
  gap: 18rpx;
  color: #39413c;
  font-size: 23rpx;
  line-height: 1.55;
  justify-content: space-between;
}

.scoring-basis-row text:first-child {
  min-width: 0;
  flex: 1;
}

.scoring-basis-row text:last-child {
  flex: 0 0 auto;
  font-weight: 700;
}

.scoring-page,
.scoring-source-note {
  margin-top: 5rpx;
  color: #788079;
  font-size: 20rpx;
  line-height: 1.5;
}

.subjective-response {
  margin-top: 30rpx;
}

.subjective-response textarea {
  width: 100%;
  height: 310rpx;
  padding: 22rpx;
  color: #303530;
  background: #ffffff;
  border: 1rpx solid #dedfdb;
  border-radius: 8rpx;
  font-size: 27rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.subjective-response textarea[disabled] {
  color: #505550;
  background: #f5f5f3;
}

.subjective-response-meta {
  display: flex;
  margin-top: 10rpx;
  color: #898d89;
  font-size: 19rpx;
  justify-content: space-between;
}

.score-report-head {
  display: flex;
  min-height: 126rpx;
  padding-bottom: 24rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.score-report-label {
  color: #6d726d;
  font-size: 21rpx;
}

.score-report-number {
  margin-top: 4rpx;
  color: #242724;
  font-size: 25rpx;
  font-weight: 700;
}

.score-report-number text {
  font-size: 66rpx;
  font-weight: 900;
}

.score-report-meta {
  color: #7d827d;
  font-size: 19rpx;
  text-align: right;
}

.score-report-meta text {
  display: inline-block;
  margin-bottom: 9rpx;
  padding: 7rpx 10rpx;
  color: #6d5422;
  background: #f5edda;
  border-radius: 6rpx;
}

.score-report-section {
  padding: 24rpx 0;
  border-top: 1rpx solid #e8e9e6;
}

.score-section-title {
  margin-bottom: 13rpx;
  color: #303430;
  font-size: 24rpx;
  font-weight: 800;
}

.score-point {
  padding: 15rpx 0 15rpx 16rpx;
  border-left: 4rpx solid #c7cbc7;
}

.score-point + .score-point {
  margin-top: 8rpx;
}

.score-point-hit {
  border-left-color: #4a9870;
}

.score-point-missed {
  border-left-color: #c58731;
}

.score-point-row {
  display: flex;
  color: #373b37;
  font-size: 22rpx;
  font-weight: 700;
  justify-content: space-between;
  gap: 16rpx;
}

.score-point-row text:first-child {
  min-width: 0;
  flex: 1;
}

.answer-variant {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #e7e8e4;
}

.answer-variant > text {
  color: #7a817b;
  font-size: 20rpx;
  font-weight: 700;
}

.score-point-row text:last-child {
  flex: 0 0 auto;
  font-variant-numeric: tabular-nums;
}

.score-point-detail,
.score-section-empty {
  margin-top: 6rpx;
  color: #7b817c;
  font-size: 20rpx;
  line-height: 1.55;
}

.score-section-empty {
  padding: 12rpx 0;
}

.score-advice {
  position: relative;
  padding: 8rpx 0 8rpx 24rpx;
  color: #5d635e;
  font-size: 21rpx;
  line-height: 1.6;
}

.score-advice::before {
  position: absolute;
  top: 22rpx;
  left: 4rpx;
  width: 7rpx;
  height: 7rpx;
  background: #9fa49f;
  border-radius: 50%;
  content: "";
}

.score-advice-error {
  color: #98463f;
}

.score-advice-error::before {
  background: #b9574e;
}

.score-comparison {
  color: #555b56;
  font-size: 21rpx;
  line-height: 1.65;
}

.score-reference-answer {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #f3f3f1;
  border-radius: 8rpx;
}

.score-basis {
  padding: 18rpx 20rpx;
  color: #777c77;
  background: #f3f3f1;
  border-radius: 8rpx;
  font-size: 19rpx;
  line-height: 1.6;
}

.score-report-actions {
  display: flex;
  margin-top: 18rpx;
  gap: 12rpx;
}

.score-report-actions button {
  display: flex;
  height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #4e534f;
  background: #eeeeec;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
}

.score-report-actions button[disabled] {
  color: #a5a9a5;
  background: #f3f3f1;
}

.score-helpfulness {
  display: flex;
  margin-top: 18rpx;
  padding-top: 18rpx;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  border-top: 1rpx solid #e8e9e6;
  color: #6f746f;
  font-size: 20rpx;
}

.score-helpfulness > text {
  display: block;
  width: 100%;
  line-height: 1.4;
}

.score-helpfulness > view {
  display: flex;
  width: 100%;
  gap: 12rpx;
}

.score-helpfulness button {
  display: flex;
  height: 60rpx;
  margin: 0;
  padding: 0 14rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #6f746f;
  background: #eeeeec;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1;
}

.score-helpfulness .score-feedback-active {
  color: #ffffff;
  background: #303030;
}

.potato-ai-entry {
  position: fixed;
  z-index: 800;
  width: 112rpx;
  height: 124rpx;
  transition: left 180ms ease, top 180ms ease, transform 180ms ease;
}

.potato-ai-entry-left {
  transform: rotate(18deg);
  transform-origin: 0 100%;
}

.potato-ai-entry-right {
  transform: rotate(-18deg);
  transform-origin: 100% 100%;
}

.potato-ai-entry.potato-ai-dragging {
  opacity: 0.86;
  transform: rotate(0deg);
  transition: none;
}

.potato-ai-image {
  width: 112rpx;
  height: 124rpx;
  pointer-events: none;
}

.practice-footer {
  height: calc(196rpx + env(safe-area-inset-bottom));
  padding: 0;
  flex: 0 0 auto;
  background: #f7f7f5;
  box-sizing: border-box;
}

.floating-action-zone {
  display: flex;
  height: 104rpx;
  overflow: hidden;
  padding: 12rpx 20rpx;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.practice-tools {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  height: calc(92rpx + env(safe-area-inset-bottom));
  padding: 4rpx 20rpx calc(10rpx + env(safe-area-inset-bottom));
  align-items: stretch;
  background: #fbfbfa;
  border-top: 1rpx solid #e5e5e2;
  box-sizing: border-box;
}

.practice-tools .practice-tool-item {
  display: flex;
  width: 25%;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 6rpx 0 4rpx;
  flex: 0 0 25%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #676d69;
  background: transparent;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.practice-tools .practice-tool-item:active {
  background: #eeeeec;
}

.footer-tool-icon {
  position: relative;
  width: 34rpx;
  height: 30rpx;
  margin-bottom: 5rpx;
  box-sizing: border-box;
}

.answer-card-icon {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
}

.answer-card-icon view {
  border: 3rpx solid #5f6762;
  border-radius: 2rpx;
}

.note-icon {
  padding: 6rpx 5rpx;
  border: 3rpx solid #5f6762;
  border-radius: 3rpx;
}

.note-icon view {
  height: 3rpx;
  margin-bottom: 5rpx;
  background: #5f6762;
}

.feedback-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #5f6762;
  border-radius: 50%;
  font-size: 21rpx;
  font-weight: 800;
}

.bookmark-icon {
  color: #5f6762;
  font-size: 34rpx;
  line-height: 30rpx;
  text-align: center;
}

.practice-tool-active,
.practice-tool-active .bookmark-icon {
  color: #9a6700;
}

.settings-icon {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.settings-icon view {
  position: relative;
  height: 3rpx;
  background: currentColor;
}

.settings-icon view::after {
  position: absolute;
  top: -4rpx;
  width: 10rpx;
  height: 10rpx;
  background: currentColor;
  border-radius: 50%;
  content: "";
}

.settings-icon view:nth-child(1)::after,
.settings-icon view:nth-child(3)::after {
  left: 5rpx;
}

.settings-icon view:nth-child(2)::after {
  right: 5rpx;
}

.mode-icon {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.mode-icon view {
  position: relative;
