  display: grid;
  min-height: 94rpx;
  padding: 0 6rpx;
  grid-template-columns: 142rpx minmax(0, 1fr);
  align-items: center;
  border-bottom: 1rpx solid #ecece9;
  box-sizing: border-box;
}

.chapter-picker-label {
  color: #303430;
  font-size: 22rpx;
  font-weight: 750;
}

.chapter-picker-row picker {
  width: 100%;
}

.chapter-picker-value {
  display: flex;
  min-width: 0;
  height: 66rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: space-between;
  color: #333734;
  background: #f1f2f0;
  border-radius: 7rpx;
  font-size: 21rpx;
  box-sizing: border-box;
}

.chapter-picker-value text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chapter-picker-chevron {
  margin-left: 14rpx;
  flex: 0 0 auto;
  color: #747a76;
  font-size: 24rpx;
}

.chapter-picker-disabled {
  opacity: 0.42;
}

.chapter-picker-confirm {
  display: flex;
  width: 100%;
  height: 78rpx;
  margin: 28rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 7rpx;
  font-size: 22rpx;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.chapter-scope-row {
  display: flex;
  width: 100%;
  min-height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  align-items: center;
  justify-content: space-between;
  color: #4c514e;
  background: transparent;
  border-radius: 6rpx;
  font-size: 21rpx;
  line-height: 1.35;
  text-align: left;
  box-sizing: border-box;
}

.chapter-scope-row + .chapter-scope-row {
  border-top: 1rpx solid #ecece9;
}

.chapter-scope-choice {
  min-height: 82rpx;
  color: #303431;
  font-size: 22rpx;
  font-weight: 700;
}

.chapter-scope-all {
  min-height: 78rpx;
  margin-bottom: 10rpx;
  color: #ffffff;
  background: #303030;
  font-weight: 750;
}

.chapter-scope-all .chapter-scope-count {
  color: #d8dad8;
}

.chapter-picker-context {
  padding: 4rpx 18rpx 18rpx;
  overflow: hidden;
  color: #8a8e8a;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chapter-scope-level-1 {
  min-height: 78rpx;
  color: #262a27;
  font-size: 23rpx;
  font-weight: 800;
}

.chapter-scope-level-2 {
  padding-left: 42rpx;
  font-weight: 650;
}

.chapter-scope-level-3,
.chapter-scope-level-4,
.chapter-scope-level-5 {
  min-height: 66rpx;
  padding-left: 72rpx;
  color: #747975;
  font-size: 19rpx;
}

.chapter-scope-title {
  min-width: 0;
  padding-right: 16rpx;
  flex: 1;
}

.chapter-scope-count {
  flex: 0 0 auto;
  color: #929692;
  font-size: 18rpx;
  font-weight: 500;
}

.chapter-scope-active {
  color: #ffffff;
  background: #303030;
}

.chapter-scope-active .chapter-scope-count {
  color: #d7d9d7;
}

/* 反馈提交按钮：按钮内文字上下左右居中（产品负责人 2026-10-01）──────────────
   只改"居中方式"，不动按钮宽度/位置/弹层布局：用 flex 双向居中，并把 line-height 归 1
   （原来靠 height 与 line-height 相等来对垂直，字体度量不同就会看着偏）。
   与仓库既有的 .submit-button 写法一致（display:flex + align-items/justify-content + line-height:1）。 */
.feedback-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  text-align: center;
}
