<view class="page-shell tab-page review-page">
  <view class="review-custom-nav" style="height: {{navTotalHeight}}px; padding-top: {{statusBarHeight}}px; padding-right: {{capsuleSafeRight}}px;">
    <view class="review-project-selector">
      <view class="review-project-trigger {{projectMenuOpen ? 'review-project-trigger-open' : ''}}" bindtap="toggleProjectMenu" role="button" aria-label="切换复习项目">
        <view class="review-project-icon" aria-hidden="true"><view></view></view>
        <text>{{activeProjectName}}</text>
        <view class="review-project-chevron"></view>
      </view>
      <view class="review-project-menu" wx:if="{{projectMenuOpen}}"><view class="review-project-option {{activeProjectId === item.id ? 'review-project-option-active' : ''}} {{!item.enabled ? 'review-project-option-disabled' : ''}}" wx:for="{{projects}}" wx:key="id" data-id="{{item.id}}" bindtap="selectProject"><text>{{item.name}}</text><label>{{item.enabled ? (activeProjectId === item.id ? '当前' : '') : '筹备中'}}</label></view></view>
    </view>
  </view>
  <view class="review-nav-spacer" style="height: {{navTotalHeight}}px;"></view>

  <view class="announcement-bar" wx:if="{{announcements.length}}" bindtap="openAnnouncement" role="button" aria-label="查看公告详情">
    <view class="announcement-icon"><image src="/assets/icons/megaphone.svg" mode="aspectFit" /></view>
    <text class="announcement-summary">{{activeAnnouncement.summary}}</text>
    <text class="announcement-detail">详情</text>
  </view>

  <view class="progress-heading">
    <view class="progress-title">今日进度</view>
    <view class="progress-streak">连续学习 {{studyStreak}} 天</view>
  </view>
  <view class="review-stats panel">
    <view class="review-stat" wx:for="{{reviewStats}}" wx:key="label">
      <text>{{item.value}}</text>
      <label>{{item.label}}</label>
    </view>
    <picker class="review-countdown-picker" mode="date" value="{{examDate}}" start="{{todayDate}}" bindchange="changeExamDate">
      <view class="review-stat review-countdown-stat">
        <text>{{examCountdownText}}</text>
        <label>{{examDate ? '考试倒计时' : '设置考试'}}</label>
      </view>
    </picker>
  </view>

  <view class="review-list-heading review-today-heading" bindtap="openTodayCalendar" role="button" aria-label="查看今日复习安排">
    <view>待复习</view>
    <text>今日完成 {{completedToday}} / {{todayReviewTotal}}</text>
  </view>
  <view class="review-summary review-today-summary" bindtap="openTodayCalendar" role="button" aria-label="查看今日待复习题目">
    <view class="summary-top">
      <view class="summary-main"><view class="summary-number">{{dueCount}}<text>题</text></view><view class="summary-title">待复习</view></view>
      <button wx:if="{{dueCount}}" class="primary-button review-button" catchtap="startDueReview">开始复习</button>
      <view wx:else class="summary-empty">今日已完成</view>
    </view>
  </view>
  <view class="summary-meta">预计 {{dueEstimatedMinutes}} 分钟 · 今日已完成 {{completedToday}} 题</view>

  <view class="review-tools-heading">
    <view>复习工具</view>
    <text>管理你的学习资产</text>
  </view>
  <view class="review-tools-panel">
    <swiper class="review-tools-swiper" current="{{reviewToolPageIndex}}" duration="240" bindchange="changeReviewToolPage" skip-hidden-item-layout="true">
      <swiper-item wx:for="{{reviewToolPages}}" wx:key="key" wx:for-item="toolPage">
        <view class="review-tools-grid">
          <view class="review-tool {{tool.disabled ? 'review-tool-disabled' : ''}} {{activeFilter === tool.filter ? 'review-tool-active' : ''}}" wx:for="{{toolPage.tools}}" wx:key="key" wx:for-item="tool" data-key="{{tool.key}}" bindtap="openReviewTool" role="button" aria-label="{{tool.label}}">
            <view class="review-tool-icon review-tool-icon-{{tool.key}}"><view class="review-tool-glyph"></view></view>
            <view class="review-tool-name">{{tool.label}}</view>
            <text wx:if="{{tool.disabled}}">规划中</text>
            <text wx:elif="{{tool.count}}">{{tool.count}} 项</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="review-tools-pagination" wx:if="{{reviewToolPages.length > 1}}" aria-hidden="true">
      <view class="review-tools-page-dot {{pageIndex === reviewToolPageIndex ? 'review-tools-page-dot-active' : ''}}" wx:for="{{reviewToolPages}}" wx:key="key" wx:for-item="page" wx:for-index="pageIndex"></view>
    </view>
  </view>

  <block wx:if="{{activeFilter !== 'due'}}">
    <view id="review-content-anchor" class="review-list-heading">
      <view>{{activeFilterLabel}}</view>
      <text bindtap="resetToDue">收起</text>
    </view>
    <view class="review-summary">
      <view class="summary-top">
        <view class="summary-main"><view class="summary-number">{{activeQuestionIds.length}}<text>题</text></view><view class="summary-title">{{summaryTitle}}</view></view>
        <button wx:if="{{activeQuestionIds.length}}" class="primary-button review-button" bindtap="startReview">{{reviewActionLabel}}</button>
        <view wx:else class="summary-empty">暂无待处理内容</view>
      </view>
    </view>
    <view class="summary-meta">共 {{activeQuestionIds.length}} 项内容</view>

    <view class="section-title">{{listTitle}}</view>
    <view class="queue-list panel" wx:if="{{visibleReviewItems.length}}">
      <view class="queue-row" wx:for="{{visibleReviewItems}}" wx:key="id" data-question-id="{{item.id}}" bindtap="startReviewFromQuestion">
        <view class="queue-index">{{index + 1}}</view>
        <view class="queue-main">
          <view class="queue-label">{{item.stem}}</view>
          <view class="queue-detail">{{item.breadcrumb}} · {{item.knowledgePoint}}</view>
        </view>
        <view class="queue-state queue-state-{{item.stateTone}}">{{item.stateLabel}}</view>
      </view>
    </view>
    <view class="review-empty" wx:else>
      <view class="review-empty-title">暂无题目</view>
      <view>完成练习后会自动加入复习。</view>
    </view>
  </block>

  <view class="reminder-row panel">
    <view>
      <view class="reminder-title">每日复习提醒</view>
      <view class="reminder-desc">{{reminderStatusText}}</view>
    </view>
    <picker class="reminder-time-picker" mode="time" value="{{reminderTime}}" bindchange="changeReminderTime"><view>{{reminderTime}}</view></picker>
    <switch color="#0b9588" checked="{{reminderEnabled}}" bindchange="toggleReminder" />
  </view>

  <view class="announcement-layer" wx:if="{{announcementOpen && announcements.length}}" bindtap="closeAnnouncement">
    <view class="announcement-dialog" catchtap="stopPropagation">
      <view class="announcement-dialog-head">
        <view>公告</view>
        <view class="announcement-close" bindtap="closeAnnouncement" role="button" aria-label="关闭">×</view>
      </view>
      <swiper class="announcement-swiper" current="{{announcementIndex}}" duration="220" bindchange="changeAnnouncement">
        <swiper-item wx:for="{{announcements}}" wx:key="id">
          <scroll-view class="announcement-scroll" scroll-y="true">
            <view class="announcement-type">{{item.type}}</view>
            <view class="announcement-title">{{item.title}}</view>
            <view class="announcement-date">{{item.date}}</view>
            <text class="announcement-content" selectable="true">{{item.content}}</text>
          </scroll-view>
        </swiper-item>
      </swiper>
      <view class="announcement-pagination">
        <view class="announcement-dots">
          <view class="announcement-dot {{index === announcementIndex ? 'announcement-dot-active' : ''}}" wx:for="{{announcements}}" wx:key="id"></view>
        </view>
        <text>{{announcementIndex + 1}} / {{announcements.length}}</text>
      </view>
    </view>
  </view>
</view>
