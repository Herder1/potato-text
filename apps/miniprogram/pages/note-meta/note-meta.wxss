.note-meta-page { padding-top: 34rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); background: #f5f7f4; }
.meta-heading view { color: #222622; font-size: 40rpx; font-weight: 900; }.meta-heading text { display: block; margin-top: 6rpx; color: #7c847f; font-size: 21rpx; }
.draft-summary { margin-top: 26rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e4e7e4; border-radius: 8rpx; }.draft-title { overflow: hidden; font-size: 27rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }.draft-excerpt { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #69716c; font-size: 20rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.draft-meta { display: flex; margin-top: 13rpx; color: #929894; font-size: 17rpx; gap: 16rpx; }
.section-head { display: flex; margin: 34rpx 2rpx 12rpx; align-items: center; justify-content: space-between; }.section-head view { color: #2b302c; font-size: 28rpx; font-weight: 900; }.section-head text { color: #7d8580; font-size: 18rpx; }.recommendation-note { display: flex; min-height: 68rpx; margin-bottom: 10rpx; padding: 12rpx 16rpx; align-items: center; justify-content: space-between; background: #eaf4f5; border-radius: 7rpx; gap: 18rpx; box-sizing: border-box; }.recommendation-note text { color: #22738a; font-size: 17rpx; font-weight: 750; white-space: nowrap; }.recommendation-note view { overflow: hidden; color: #65736d; font-size: 17rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.directory-panel { overflow: hidden; background: #fff; border-radius: 8rpx; }.directory-row { display: grid; min-height: 86rpx; padding: 0 20rpx; grid-template-columns: 118rpx minmax(0,1fr); align-items: center; border-bottom: 1rpx solid #e7eae7; }.directory-row > text { color: #77817b; font-size: 20rpx; }.directory-row > view { overflow: hidden; font-size: 21rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }.directory-row-disabled { opacity: .48; }
.tag-heading { margin-bottom: 8rpx; }.recommended-tags,.selected-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }.recommended-tags view,.selected-tags view { padding: 9rpx 12rpx; border-radius: 5rpx; font-size: 18rpx; }.recommended-tags view { color: #38768a; background: #e5f1f4; }.selected-tags { margin-top: 10rpx; }.selected-tags view { color: #675676; background: #eee9f2; }
.tag-editor { display: grid; width: 100%; height: 72rpx; margin-top: 11rpx; grid-template-columns: minmax(0,1fr) 102rpx; gap: 9rpx; box-sizing: border-box; }.tag-editor input { min-width: 0; height: 100%; padding: 0 17rpx; background: #fff; border-radius: 7rpx; font-size: 20rpx; box-sizing: border-box; }.tag-editor > view { display: flex; width: 102rpx; height: 72rpx; align-items: center; justify-content: center; color: #fff; background: #555b57; border-radius: 7rpx; font-size: 20rpx; font-weight: 750; }
.target-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 9rpx; }.target { display: flex; height: 70rpx; align-items: center; justify-content: center; color: #69716c; background: #e7eae7; border: 2rpx solid transparent; border-radius: 7rpx; font-size: 20rpx; box-sizing: border-box; }.target-active { color: #26738b; background: #fff; border-color: #5795aa; font-weight: 750; }
.choice-row { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 9rpx; }.choice { display: flex; height: 72rpx; align-items: center; justify-content: center; color: #68716b; background: #e7eae7; border: 2rpx solid transparent; border-radius: 7rpx; font-size: 20rpx; box-sizing: border-box; }.choice-active { color: #256d87; background: #fff; border-color: #4d91a9; font-weight: 800; }.source-field { height: 76rpx; margin-top: 10rpx; padding: 0 17rpx; background: #fff; border-radius: 7rpx; }.source-field input { height: 100%; font-size: 21rpx; }.declaration { display: flex; min-height: 72rpx; margin-top: 7rpx; align-items: center; color: #59615c; font-size: 20rpx; }.declaration checkbox { margin-right: 8rpx; transform: scale(.82); }.visibility-row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 9rpx; }.visibility { min-height: 94rpx; padding: 15rpx; background: #e7eae7; border: 2rpx solid transparent; border-radius: 7rpx; box-sizing: border-box; }.visibility text { font-size: 21rpx; font-weight: 850; }.visibility view { margin-top: 5rpx; color: #858c87; font-size: 18rpx; }.visibility-active { background: #fff; border-color: #4d91a9; }
.save-note { display: flex; width: 100%; height: 86rpx; margin-top: 30rpx; align-items: center; justify-content: center; color: #fff; background: #303330; border-radius: 8rpx; font-size: 23rpx; font-weight: 800; box-sizing: border-box; }
