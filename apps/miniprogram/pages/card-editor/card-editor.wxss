.page {
  min-height: 100vh;
  color: #28312b;
  background: #f4f6f4;
  box-sizing: border-box;
}

.editor-nav {
  position: fixed;
  z-index: 120;
  top: 0;
  right: 0;
  left: 0;
  display: grid;
  padding-left: 16rpx;
  grid-template-columns: 68rpx minmax(140rpx, 1fr) 76rpx;
  align-items: center;
  background: rgba(244, 246, 244, .98);
  border-bottom: 1rpx solid #e5e9e6;
  box-sizing: border-box;
}

.nav-back {
  display: flex;
  width: 68rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
}

.nav-back image {
  width: 36rpx;
  height: 36rpx;
}

.nav-type {
  display: flex;
  min-width: 0;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  color: #222a25;
  font-size: 27rpx;
  font-weight: 800;
  gap: 11rpx;
}

.nav-type text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-chevron {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-right: 3rpx solid #65736b;
  border-bottom: 3rpx solid #65736b;
  transform: translateY(-4rpx) rotate(45deg);
  transition: transform .18s ease;
}

.nav-chevron-open {
  transform: translateY(4rpx) rotate(225deg);
}

.nav-save {
  display: flex;
  height: 72rpx;
  align-items: center;
  justify-content: flex-end;
  color: #0b9588;
  font-size: 21rpx;
  font-weight: 800;
}

.editor-body {
  padding: 18rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
}

.field {
  margin-top: 16rpx;
  padding: 23rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(42, 57, 48, .045);
  box-sizing: border-box;
}

.field label {
  display: block;
  margin-bottom: 13rpx;
  color: #53615a;
  font-size: 19rpx;
}

.question-field textarea {
  width: 100%;
  min-height: 100rpx;
  color: #28312b;
  font-size: 25rpx;
  line-height: 1.58;
  box-sizing: border-box;
}

.answer-field {
  overflow: visible;
  min-height: 330rpx;
}

.answer-editor {
  width: 100%;
  min-height: 260rpx;
  height: auto;
  color: #28312b;
  font-size: 25rpx;
  line-height: 1.72;
  box-sizing: border-box;
}

.field.compact input {
  height: 50rpx;
  color: #28312b;
  font-size: 24rpx;
}

.type-picker-mask {
  position: fixed;
  z-index: 130;
  inset: 0;
  background: rgba(27, 38, 32, .28);
}

.type-picker {
  position: fixed;
  z-index: 131;
  right: 72rpx;
  left: 72rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 46rpx rgba(29, 45, 35, .2);
}

.type-picker-head {
  display: flex;
  height: 64rpx;
  padding: 0 8rpx;
  align-items: center;
  justify-content: space-between;
  color: #27302a;
  border-bottom: 1rpx solid #e9eeea;
  font-size: 23rpx;
  font-weight: 750;
}

.type-picker-head view {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  color: #7f8a83;
  font-size: 32rpx;
  font-weight: 400;
}

.type-option {
  display: flex;
  min-height: 100rpx;
  padding: 16rpx 12rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0ee;
  box-sizing: border-box;
}

.type-option:last-child {
  border-bottom: 0;
}

.type-option > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.type-option > view text {
  color: #303a34;
  font-size: 22rpx;
}

.type-option label {
  color: #8a958e;
  font-size: 17rpx;
}

.type-option > text {
  color: #0b9588;
  font-size: 25rpx;
}

.type-option-active {
  background: #f0f9f6;
  border-radius: 10rpx;
}

.answer-tools-slot {
  position: relative;
  height: 114rpx;
}

.answer-tools-anchor {
  position: relative;
  z-index: 12;
  width: 100%;
  height: 96rpx;
  overflow: visible;
}

.answer-tools-anchor-docked {
  position: fixed;
  z-index: 210;
  right: 0;
  left: 0;
  width: auto;
}

.keyboard-toolbar {
  width: 100%;
  height: 96rpx;
  background: rgba(255, 255, 255, .99);
  border: 1rpx solid #e1e6e2;
  border-radius: 12rpx;
  box-shadow: 0 3rpx 10rpx rgba(37, 48, 41, .045);
  overflow: hidden;
  box-sizing: border-box;
}

.answer-tools-anchor-docked .keyboard-toolbar {
  border-right: 0;
  border-left: 0;
  border-radius: 0;
  box-shadow: 0 -8rpx 24rpx rgba(37, 48, 41, .08);
}

.toolbar-scroll {
  width: 100%;
  height: 96rpx;
  white-space: nowrap;
}

.toolbar-track {
  display: inline-flex;
  height: 96rpx;
  padding: 5rpx 10rpx;
  align-items: center;
  gap: 3rpx;
  box-sizing: border-box;
}

.answer-tools-anchor-inline .toolbar-track {
  padding-right: 4rpx;
  padding-left: 4rpx;
  gap: 1rpx;
}

.answer-tools-anchor-inline .tool-button {
  width: 78rpx;
  flex-basis: 78rpx;
}

.tool-button {
  display: flex;
  width: 88rpx;
  height: 84rpx;
  flex: 0 0 88rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #505954;
  background: transparent;
  border-radius: 9rpx;
  gap: 5rpx;
  box-sizing: border-box;
}

.tool-button:active,
.tool-active {
  color: #176d93;
  background: #e7f3f8;
}

.tool-button image {
  width: 32rpx;
  height: 32rpx;
}

.tool-button > text {
  display: flex;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  line-height: 32rpx;
}

.tool-button label {
  overflow: hidden;
  width: 100%;
  color: inherit;
  font-size: 15rpx;
  line-height: 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.format-bold {
  font-family: sans-serif;
  font-size: 28rpx;
  font-weight: 900;
}

.format-italic {
  font-family: serif;
  font-size: 29rpx;
  font-style: italic;
}

.format-underline {
  font-family: serif;
  font-size: 27rpx;
  text-decoration: underline;
}

.format-strike {
  font-family: serif;
  font-size: 27rpx;
  text-decoration: line-through;
}

.format-more {
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.format-list,
.format-size,
.format-clear {
  font-size: 22rpx;
  font-weight: 750;
}

.format-align {
  width: 30rpx;
  font-size: 31rpx;
  line-height: 26rpx;
  text-align: left;
}

.format-align-center {
  text-align: center;
}

.format-color {
  position: relative;
  font-family: serif;
  font-size: 27rpx;
}

.format-color::after {
  position: absolute;
  right: 1rpx;
  bottom: 0;
  left: 1rpx;
  height: 4rpx;
  content: "";
  background: #287b96;
}

.toolbar-secondary .tool-button {
  width: 84rpx;
  flex-basis: 84rpx;
}

.memory-assistant {
  position: absolute;
  z-index: 4;
  right: 0;
  width: 486rpx;
  max-width: calc(100vw - 40rpx);
  padding: 10rpx;
  background: #fff;
  border: 1rpx solid #e1e6e2;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 44rpx rgba(28, 38, 32, .16);
  box-sizing: border-box;
}

.answer-tools-anchor-inline .memory-assistant {
  top: calc(100% + 8rpx);
}

.answer-tools-anchor-docked .memory-assistant {
  right: 20rpx;
  bottom: calc(100% + 8rpx);
}

.assistant-action {
  display: grid;
  min-height: 92rpx;
  padding: 12rpx 14rpx;
  grid-template-columns: 48rpx minmax(0, 1fr);
  align-items: center;
  gap: 13rpx;
  border-bottom: 1rpx solid #edf0ee;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.assistant-action:last-child {
  border-bottom: 0;
}

.assistant-action:active {
  background: #f1f5f2;
}

.assistant-action image {
  width: 38rpx;
  height: 38rpx;
  justify-self: center;
}

.assistant-action > view {
  min-width: 0;
}

.assistant-action text,
.assistant-action label {
  display: block;
}

.assistant-action text {
  color: #2c332f;
  font-size: 22rpx;
  font-weight: 750;
}

.assistant-action label {
  overflow: hidden;
  margin-top: 5rpx;
  color: #808a84;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
