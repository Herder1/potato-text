.help-page {
  padding-top: 28rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.help-title {
  color: #1b1e1c;
  font-size: 42rpx;
  font-weight: 900;
}

.help-subtitle {
  margin-top: 7rpx;
  color: #858b87;
  font-size: 20rpx;
}

.help-tabs {
  display: grid;
  height: 70rpx;
  margin-top: 26rpx;
  padding: 5rpx;
  background: #eceeeb;
  border-radius: 20rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  box-sizing: border-box;
}

.help-tab {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  color: #777e79;
  border-radius: 16rpx;
  font-size: 21rpx;
}

.help-tab-active {
  color: #202421;
  background: rgba(255, 255, 255, 0.9);
  font-weight: 800;
}

.help-search {
  display: flex;
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  align-items: center;
  gap: 15rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid #e6e9e5;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.help-search input {
  min-width: 0;
  height: 100%;
  color: #2e332f;
  font-size: 22rpx;
  flex: 1;
}

.search-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
  border: 3rpx solid #747c77;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 3rpx;
  background: #747c77;
  content: "";
  transform: rotate(45deg);
}

.section-label,
.form-label {
  color: #555d58;
  font-size: 21rpx;
  font-weight: 800;
}

.section-label {
  margin: 32rpx 2rpx 13rpx;
}

.faq-list,
.feedback-form,
.feedback-history {
  overflow: hidden;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
}

.faq-row {
  padding: 0 22rpx;
  border-bottom: 1rpx solid #e9ece8;
}

.faq-row:last-child {
  border-bottom: 0;
}

.faq-question {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.faq-question > view:first-child {
  min-width: 0;
  flex: 1;
}

.faq-question text {
  display: block;
  color: #8a918c;
  font-size: 17rpx;
}

.faq-question view view {
  margin-top: 5rpx;
  color: #2c312d;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.45;
}

.faq-chevron,
.entry-arrow {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-right: 3rpx solid #7d8580;
  border-bottom: 3rpx solid #7d8580;
}

.faq-chevron {
  margin-top: -7rpx;
  transform: rotate(45deg);
  transition: transform 180ms ease;
}

.faq-chevron-open {
  margin-top: 5rpx;
  transform: rotate(225deg);
}

.faq-answer {
  padding: 0 34rpx 24rpx 0;
  color: #646c67;
  font-size: 21rpx;
  line-height: 1.75;
}

.help-empty,
.history-loading {
  padding: 70rpx 24rpx;
  color: #8b928d;
  text-align: center;
  font-size: 21rpx;
}

/* 在线客服入口（外观按产品负责人 2026-10-01 给的样式图）。
   ⚠️ 两次真机教训（2026-10-01）：小程序 <button> 自带 display/text-align/padding/line-height 且**类规则压不住**，
   把它当卡片或 flex 容器都会在真机上散架（内容居中、文字挤成窄列）。
   所以最终做法：**卡片全用普通 view，button 只做一张透明的整卡点击层**（.contact-hit），彻底不参与布局。
   另外行内布局也不用 flex，改成"卡片内边距 + 绝对定位图标/箭头"，任何引擎下都不会被挤。 */
.contact-card {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-height: 124rpx;
  margin-top: 20rpx;
  padding: 20rpx 68rpx 20rpx 128rpx; /* 右留给箭头，左留给图标 */
  border-radius: 24rpx;
  /* 颜色按产品负责人 2026-10-01 指定：取「我的」页顶部那条渐变（与 profile.wxss 同值） */
  background: #e9f7f2;
  background-image: linear-gradient(150deg, #e6f7f1 0%, #f4f6f2 42%, #fbeedd 72%, #f7f7f5 100%);
  overflow: hidden;
}

/* 背景装饰圆：跟着卡片配色走（薄荷 + 奶油），留在内容之下 */
.contact-blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(160, 214, 196, 0.3);
}
.contact-blob-top { top: -30rpx; right: -18rpx; width: 132rpx; height: 96rpx; }
.contact-blob-bottom { right: 54rpx; bottom: -44rpx; width: 150rpx; height: 104rpx; background: rgba(250, 226, 196, 0.55); }

.contact-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  margin-top: -42rpx;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  /* 产品负责人 2026-10-02 最终口径：**块=绿、线条=黄**（此前做反过一次） */
  background: #cbe8dc;
  background-image: linear-gradient(160deg, #d8f0e6 0%, #bfe2d3 100%);
}
.contact-icon-img { display: block; width: 48rpx; height: 48rpx; }

.contact-copy { position: relative; display: block; }
.contact-title { color: #23262a; font-size: 30rpx; font-weight: 850; line-height: 1.3; }
.contact-subtitle { margin-top: 6rpx; color: #6f7a75; font-size: 22rpx; line-height: 1.35; }

.contact-card .entry-arrow {
  position: absolute;
  right: 26rpx;
  top: 50%;
  margin-top: -7rpx;
  border-color: #7f8b85;
}

/* 透明的整卡点击层：只有它带 open-type="contact"。
   必须 position:absolute 铺满 + opacity:0（不能用 display/visibility 隐藏，否则点不到）。 */
.contact-hit {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  line-height: normal !important;
  opacity: 0;
  z-index: 3;
}
.contact-hit::after { border: none !important; }

.login-notice {
  display: flex;
  min-height: 102rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #eef1ee;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.login-notice text {
  color: #303632;
  font-size: 22rpx;
  font-weight: 800;
}

.login-notice view view {
  margin-top: 5rpx;
  color: #7d8580;
  font-size: 18rpx;
}

.login-notice button,
.history-empty button {
  display: flex;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #303330;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1;
}

.feedback-form {
  margin-top: 24rpx;
  padding: 25rpx 22rpx 28rpx;
}

.category-grid {
  display: grid;
  margin-top: 14rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.category-option {
  display: flex;
  min-width: 0;
  height: 62rpx;
  padding: 0 8rpx;
  align-items: center;
  justify-content: center;
  color: #68706b;
  background: #f0f2ef;
  border: 1rpx solid transparent;
  border-radius: 6rpx;
  font-size: 19rpx;
  text-align: center;
  box-sizing: border-box;
}

.category-option-active {
  color: #186783;
  background: #e9f6fa;
  border-color: #9fd7e7;
  font-weight: 800;
}

.form-label-spaced {
  display: flex;
  margin-top: 30rpx;
  align-items: center;
  justify-content: space-between;
}

.form-label-spaced > text:last-child {
  color: #959b97;
  font-size: 17rpx;
  font-weight: 400;
}

.feedback-textarea {
  width: 100%;
  height: 240rpx;
  margin-top: 13rpx;
  padding: 18rpx;
  color: #303632;
  background: #f4f5f3;
  border-radius: 6rpx;
  font-size: 21rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.image-list {
  display: flex;
  margin-top: 13rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.image-item image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.image-item button {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  display: flex;
  width: 38rpx;
  height: 38rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #3d413e;
  border-radius: 50%;
  font-size: 28rpx;
  line-height: 1;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #838a85;
  background: #f4f5f3;
  border: 1rpx dashed #cbd0cc;
  flex-direction: column;
}

.image-add text {
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.image-add view {
  margin-top: 7rpx;
  font-size: 17rpx;
}

.contact-input {
  height: 74rpx;
  margin-top: 13rpx;
  padding: 0 18rpx;
  color: #303632;
  background: #f4f5f3;
  border-radius: 6rpx;
  font-size: 21rpx;
  box-sizing: border-box;
}

.submit-button {
  display: flex;
  width: 100%;
  height: 76rpx;
  margin: 34rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #303330;
  border-radius: 7rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.submit-button[disabled] {
  color: #929894;
  background: #e4e7e3;
}

.feedback-history {
  margin-top: 24rpx;
}

.history-item {
  padding: 22rpx;
  border-bottom: 1rpx solid #e8ebe7;
}

.history-item:last-child {
  border-bottom: 0;
}

.history-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.history-head > view text {
  display: block;
  color: #303531;
  font-size: 22rpx;
  font-weight: 850;
}

.history-head label {
  display: block;
  margin-top: 5rpx;
  color: #969c98;
  font-size: 17rpx;
}

.history-status {
  display: flex;
  min-height: 38rpx;
  padding: 0 12rpx;
  align-items: center;
  color: #7b641e;
  background: #fff1c9;
  border-radius: 4rpx;
  font-size: 17rpx;
  flex: 0 0 auto;
}

.status-processing { color: #17648d; background: #e1f2fa; }
.status-resolved { color: #287052; background: #dff3e9; }
.status-rejected { color: #6f7772; background: #e9ece9; }

.history-content {
  margin-top: 17rpx;
  color: #535b56;
  font-size: 20rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.history-meta {
  margin-top: 9rpx;
  color: #939a95;
  font-size: 17rpx;
}

.history-response {
  margin-top: 16rpx;
  padding: 15rpx;
  background: #f0f3f0;
  border-radius: 6rpx;
}

.history-response text {
  color: #267055;
  font-size: 17rpx;
  font-weight: 800;
}

.history-response view {
  margin-top: 6rpx;
  color: #505853;
  font-size: 19rpx;
  line-height: 1.6;
}

.feedback-thread {
  margin-top: 16rpx;
  padding: 15rpx;
  background: #f5f8f6;
  border-radius: 6rpx;
}

.feedback-thread-title {
  color: #267055;
  font-size: 17rpx;
  font-weight: 800;
}

.feedback-thread-message {
  margin-top: 10rpx;
}

.feedback-thread-message text {
  color: #7c8781;
  font-size: 17rpx;
}

.feedback-thread-message view {
  margin-top: 4rpx;
  color: #505853;
  font-size: 19rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.feedback-reply {
  margin-top: 16rpx;
}

.feedback-reply textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 16rpx;
  color: #424a45;
  background: #fafcfb;
  border: 1rpx solid #dce5df;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.feedback-reply button {
  margin-top: 12rpx;
  color: #fff;
  background: #267055;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.history-empty {
  display: flex;
  min-height: 330rpx;
  margin-top: 24rpx;
  align-items: center;
  justify-content: center;
  color: #858c87;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  flex-direction: column;
  gap: 20rpx;
}
