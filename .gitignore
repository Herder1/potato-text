node_modules/
.env
.env.*
!.env.example
dist/
coverage/
.runtime/
# 本地启动脚本的日志目录（start-server*.cmd / *.vbs 用 cwd 写出来的 server-3212*.log）。
# 原来只靠上面的 *.log 挡住文件、目录本身没被锚定，`git add -A` 一类操作会把空目录/其它残留带进来。
/runtime/
project.private.config.json
*.log
.DS_Store

# ---- 远程仓库与 CI 附加排除（原文件全部保留在本地，仅不进 git）----
# 原始题库资料：教材/试卷 PDF、DOCX、录题稿。单文件可达上百 MB，
# 超过 GitHub 单文件 100 MB 硬限制，且会让每次 push 与 CI checkout 变得极慢。
题目录入/
# 无头浏览器 profile、临时日志、一次性验证脚本产物（tmp/ 里没有任何需要版本化的东西）。
tmp/
# 仓库根的一次性排查产物：无头浏览器截图、接口转储 JSON、探针脚本。
# 共上百个文件、合计约百 MB（单文件最大 20MB），全部可由代码与测试重新生成。
# 只锚定仓库根，避免误伤子目录里的同名文件（例如 Store 写盘用的 "<file>.tmp-<pid>" 临时名）。
/tmp-*
/.tmp*
# 本地 Docker 编译产物 / 绑定挂载点。
.docker-data/
# Python 产物（仓库含 render-exam-pdf.py 等脚本，被 import 时会生成）。
__pycache__/
*.pyc
# 隔离验证用的"镜像布局"副本：按 Dockerfile 的 COPY 清单复制的一份 apps/packages/scripts，
# 由验证脚本临时生成、用完即删。绝不能进 git（2026-09-21 曾因 git add -A 误提交 281 个文件）。
/.smoke-docker/
